---
// Portada: una foto a pantalla completa, en blanco y negro, que se pinta con
// su color al pasar el ratón. Cabecera arriba y pie abajo, encima de la foto.
// La foto es provisional (de prueba): Guzmán elegirá la definitiva.
import Base from '../layouts/Base.astro';
import LienzoPintable from '../components/LienzoPintable.astro';
import foto from '../assets/inicio/prueba.jpg';
import { ambas, urlInicio, type Idioma } from '../lib/rutas';
import { sitio } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base idioma={idioma} alternativas={ambas(urlInicio)} descripcion={`${sitio.nombre}. ${t.inicioIntro}`}>
  <LienzoPintable foto={foto} />
  <h1 class="oculto">{sitio.nombre} — {t.profesion}</h1>
</Base>

<style>
  /* El título existe para buscadores y lectores de pantalla, pero no se ve. */
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
