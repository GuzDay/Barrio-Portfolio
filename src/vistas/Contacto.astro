---
// Contacto (28-10-2026, pedido de Pablo a través de Guzmán): una foto a
// pantalla completa, que se va pasando sola, como una tarjeta. Al pulsarla se
// da la vuelta y por detrás aparecen, centrados, el texto de Pablo y debajo
// sus datos de contacto. Pulsando otra vez (o con Esc) vuelve a la foto. El
// título "Contacto" no se ve, pero sigue ahí para buscadores y lectores de
// pantalla, que leen el texto sin tener que dar la vuelta a nada.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ambas, urlContacto, type Idioma } from '../lib/rutas';
import { sitio, urlInstagram } from '../lib/sitio';
import { textos } from '../lib/textos';

// Las fotos (las que pasó Guzmán el 28-10-2026, de 00 Barrio/Web/Contacto),
// en el orden en que se pasan: el nombre del archivo manda (01.jpg, 02.jpg…).
// A pantalla completa se recortan para llenarla (como la portada).
const fotos = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/contacto/*.jpg', { eager: true }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { texto: sitio.telefonoVisible, url: `tel:+${sitio.whatsapp}` },
  { texto: sitio.correo, url: `mailto:${sitio.correo}` },
  { texto: `@${sitio.instagram}`, url: urlInstagram },
];
---

<Base idioma={idioma} alternativas={ambas(urlContacto)} titulo={t.contacto} descripcion={t.contactoIntro} activa="contacto">
  <h1 class="oculto">{t.contacto}</h1>

  <div class="escena">
    <div class="tarjeta">
      {/* Delante: las fotos. Todo el frente es un botón para dar la vuelta. */}
      <button class="cara frente" type="button" aria-label={t.acercaDe} aria-expanded="false">
        {fotos.map((foto, i) => (
          <Image
            class:list={['foto', { activa: i === 0 }]}
            src={foto}
            alt=""
            widths={[600, 900, 1200, 1600, 2000]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        ))}
      </button>

      {/* Detrás: el texto y los datos, centrados. */}
      <div class="cara dorso">
        <div class="contenido">
          <div class="biografia">
            {t.biografia.map((parrafo) => <p>{parrafo}</p>)}
          </div>
          <ul class="enlaces">
            {enlaces.map(({ texto, url }) => <li><a href={url}>{texto}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  const tarjeta = document.querySelector<HTMLElement>('.escena .tarjeta')!;
  const frente = tarjeta.querySelector<HTMLButtonElement>('.frente')!;
  const dorso = tarjeta.querySelector<HTMLElement>('.dorso')!;
  const girar = (si: boolean) => {
    tarjeta.classList.toggle('girada', si);
    frente.setAttribute('aria-expanded', String(si));
  };
  // Pulsar la foto le da la vuelta; pulsar el dorso (fuera de un enlace),
  // la devuelve. Esc también la devuelve.
  frente.addEventListener('click', () => girar(true));
  dorso.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('a')) girar(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && tarjeta.classList.contains('girada')) girar(false);
  });

  // Las fotos se pasan solas, algo más despacio que antes (pedido de Pablo):
  // cada 5 s la siguiente aparece encima de la anterior, pasando de
  // desenfocada y transparente a nítida, sin moverse. Solo se anima una a la
  // vez. Se para con la tarjeta dada la vuelta, con la pestaña oculta o si se
  // ha pedido menos movimiento.
  const fotos = [...frente.querySelectorAll<HTMLImageElement>('.foto')];
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fotos.length > 1 && !quieto) {
    fotos.forEach((f) => (f.loading = 'eager'));
    let i = 0;
    let capa = 1;
    setInterval(() => {
      if (document.hidden || tarjeta.classList.contains('girada')) return;
      const siguiente = fotos[(i + 1) % fotos.length];
      if (!siguiente.complete) return;
      const anterior = fotos[i];
      anterior.classList.remove('entrando');
      siguiente.style.zIndex = String(++capa);
      siguiente.classList.add('activa', 'entrando');
      setTimeout(() => anterior.classList.remove('activa'), 1400);
      i = (i + 1) % fotos.length;
    }, 5000);
  }
</script>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* La página es la pantalla entera, sin scroll; sin pie (el copyright
     quedaría encima de la foto). La cabecera, que va fija, queda encima. */
  :global(html:has(.escena)),
  :global(body:has(.escena)) {
    overflow: hidden;
  }

  :global(body:has(.escena) .pie) {
    display: none;
  }

  .escena {
    position: fixed;
    inset: 0;
    height: 100lvh;
    perspective: 2200px;
  }

  /* La tarjeta: las dos caras, una de espaldas a la otra. Al girar, da
     media vuelta sobre su eje vertical. */
  .tarjeta {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .tarjeta.girada {
    transform: rotateY(180deg);
  }

  .cara {
    position: absolute;
    inset: 0;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* Delante: las fotos, llenando la pantalla. */
  .frente {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--vacio);
    overflow: hidden;
    cursor: pointer;
  }

  .frente :global(.foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .frente :global(.foto.activa) {
    opacity: 1;
  }

  .frente :global(.foto.entrando) {
    animation: foto-entra 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes foto-entra {
    from {
      opacity: 0;
      filter: blur(14px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* Detrás: blanco, con el texto centrado en mitad de la pantalla y, si no
     cabe (móvil pequeño), con scroll propio. */
  .dorso {
    transform: rotateY(180deg);
    display: flex;
    overflow-y: auto;
    background: var(--fondo);
    cursor: pointer;
  }

  .contenido {
    margin: auto;
    width: min(100% - 2 * var(--margen), 36rem);
    padding: 6.5rem 0 3rem;
    text-align: center;
    cursor: auto;
  }

  .biografia {
    font-family: var(--serif);
    font-size: clamp(16px, 1.15vw, 18px);
    font-weight: 300;
    line-height: 1.45;
  }

  .biografia p {
    margin: 0 0 0.8em;
  }

  .enlaces {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-weight: 300;
  }

  .enlaces a {
    text-decoration: none;
  }

  .enlaces a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta {
      transition: none;
    }
  }
</style>
