---
// Contacto: una sola página con el contacto arriba (lo primero que busca quien
// entra aquí) y, debajo, el texto de Pablo sobre sí mismo. Antes eran "Acerca
// de mí" y "Contacto"; Guzmán las unió (16-10-2026).
import Base from '../layouts/Base.astro';
import { ambas, urlContacto, type Idioma } from '../lib/rutas';
import { sitio, urlInstagram, urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base idioma={idioma} alternativas={ambas(urlContacto)} titulo={t.contacto} descripcion={t.contactoIntro} activa="contacto">
  <h1>{t.contacto}</h1>
  <p>{t.contactoIntro}</p>
  <p><a class="boton" href={urlWhatsApp(t.mensajeContacto)}>{t.escribirWhatsApp}</a></p>
  <dl>
    <div><dt>{t.telefono}</dt><dd><a href={`tel:+${sitio.whatsapp}`}>{sitio.telefonoVisible}</a></dd></div>
    <div><dt>{t.correo}</dt><dd><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></dd></div>
    <div><dt>{t.instagram}</dt><dd><a href={urlInstagram}>@{sitio.instagram}</a></dd></div>
  </dl>

  <section class="sobre-mi">
    <h2>{t.acercaDe}</h2>
    <div class="texto-largo">
      {t.biografia.map((parrafo) => <p>{parrafo}</p>)}
    </div>
  </section>
</Base>

<style>
  dl {
    margin: 2rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  dl div {
    display: flex;
    gap: 1rem;
  }

  dt {
    min-width: 6rem;
    color: var(--suave);
  }

  dd {
    margin: 0;
  }

  .sobre-mi {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--linea);
  }

  h2 {
    margin: 0 0 1rem;
  }
</style>
