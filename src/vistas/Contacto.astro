---
// Contacto (28-10-2026, pedido de Pablo a través de Guzmán): una foto a
// pantalla completa, que se va pasando sola, como una tarjeta, con el
// teléfono (lleva a WhatsApp) y el correo encima, en el centro. Al pulsar la
// foto se da la vuelta y por detrás aparece, centrado, el texto de Pablo. Pulsando otra vez (o con Esc) vuelve a la foto. El
// título "Contacto" no se ve, pero sigue ahí para buscadores y lectores de
// pantalla, que leen el texto sin tener que dar la vuelta a nada.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ambas, urlContacto, type Idioma } from '../lib/rutas';
import { sitio, urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

// Las fotos (las que pasó Guzmán el 28-10-2026, de 00 Barrio/Web/Contacto),
// en el orden en que se pasan: el nombre del archivo manda (01.jpg, 02.jpg…).
// A pantalla completa se recortan para llenarla (como la portada).
const fotos = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/contacto/*.jpg', { eager: true }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
// Encima de la foto: el teléfono, que abre WhatsApp, y el correo.
const enlaces = [
  { texto: sitio.telefonoVisible, url: urlWhatsApp(t.mensajeContacto) },
  { texto: sitio.correo, url: `mailto:${sitio.correo}` },
];
---

<Base idioma={idioma} alternativas={ambas(urlContacto)} titulo={t.contacto} descripcion={t.contactoIntro} activa="contacto">
  <h1 class="oculto">{t.contacto}</h1>

  <div class="escena">
    <div class="tarjeta">
      {/* Delante: las fotos (un botón para dar la vuelta). */}
      <div class="cara frente">
      <button class="fotos" type="button" aria-label={t.acercaDe} aria-expanded="false">
        {fotos.map((foto, i) => (
          <Image
            class:list={['foto', { activa: i === 0 }]}
            src={foto}
            alt=""
            widths={[600, 900, 1200, 1600, 2000]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        ))}
      </button>
      </div>

      {/* Detrás: el texto, centrado. */}
      <div class="cara dorso">
        <div class="contenido">
          <div class="biografia">
            {t.biografia.map((parrafo) => <p>{parrafo}</p>)}
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Los datos, encima de las fotos y fuera de la tarjeta: dentro de una
      capa en 3D la fusión "diferencia" no se aplica (salían blancos sobre el
      cielo blanco). Sueltos, como la firma, sí. Se esconden al dar la vuelta. */}
  <ul class="enlaces">
    {enlaces.map(({ texto, url }) => <li><a href={url}>{texto}</a></li>)}
  </ul>
</Base>

<script>
  const tarjeta = document.querySelector<HTMLElement>('.escena .tarjeta')!;
  const frente = tarjeta.querySelector<HTMLButtonElement>('.frente .fotos')!;
  const girar = (si: boolean) => {
    tarjeta.classList.toggle('girada', si);
    document.documentElement.classList.toggle('contacto-girada', si);
    frente.setAttribute('aria-expanded', String(si));
  };
  // Pulsar la foto le da la vuelta; con la vuelta dada, pulsar en cualquier
  // sitio (fuera de un enlace o de la cabecera) la devuelve. Esc también.
  // Antes se escuchaba solo el dorso, y a veces el navegador atribuía el
  // toque a la foto de detrás (que en 3D sigue ahí, de espaldas) y no
  // volvía: ahora la foto girada no recibe toques y el aviso lo recoge la
  // página entera.
  frente.addEventListener('click', (e) => {
    if (tarjeta.classList.contains('girada')) return;
    e.stopPropagation();
    girar(true);
  });
  document.addEventListener('click', (e) => {
    if (!tarjeta.classList.contains('girada')) return;
    const el = e.target as Element;
    if (el.closest('a, button, .cabecera')) return;
    girar(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && tarjeta.classList.contains('girada')) girar(false);
  });

  // Las fotos se pasan solas, algo más despacio que antes (pedido de Pablo):
  // cada 5 s la siguiente aparece encima de la anterior, pasando de
  // desenfocada y transparente a nítida, sin moverse. Solo se anima una a la
  // vez. Se para con la tarjeta dada la vuelta, con la pestaña oculta o si se
  // ha pedido menos movimiento.
  const fotos = [...frente.querySelectorAll<HTMLImageElement>('.foto')];
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fotos.length > 1 && !quieto) {
    fotos.forEach((f) => (f.loading = 'eager'));
    let i = 0;
    setInterval(() => {
      if (document.hidden || tarjeta.classList.contains('girada')) return;
      const siguiente = fotos[(i + 1) % fotos.length];
      if (!siguiente.complete) return;
      const anterior = fotos[i];
      // La que entra, encima; la anterior, justo debajo; el resto, al fondo.
      fotos.forEach((f) => (f.style.zIndex = ''));
      anterior.classList.remove('entrando');
      anterior.style.zIndex = '1';
      siguiente.style.zIndex = '2';
      siguiente.classList.add('activa', 'entrando');
      setTimeout(() => anterior.classList.remove('activa'), 1400);
      i = (i + 1) % fotos.length;
    }, 5000);
  }
</script>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* La página es la pantalla entera, sin scroll; sin pie (el copyright
     quedaría encima de la foto). La cabecera, que va fija, queda encima. */
  :global(html:has(.escena)),
  :global(body:has(.escena)) {
    overflow: hidden;
  }

  :global(body:has(.escena) .pie) {
    display: none;
  }

  .escena {
    position: fixed;
    inset: 0;
    height: 100lvh;
    perspective: 2200px;
  }

  /* La tarjeta: las dos caras, una de espaldas a la otra. Al girar, da
     media vuelta sobre su eje vertical. */
  .tarjeta {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .tarjeta.girada {
    transform: rotateY(180deg);
  }

  /* Solo recibe toques la cara que se ve. */
  .tarjeta.girada .frente,
  .tarjeta:not(.girada) .dorso {
    pointer-events: none;
  }

  .cara {
    position: absolute;
    inset: 0;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* Delante: las fotos, llenando la pantalla. */
  .frente .fotos {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--vacio);
    overflow: hidden;
    cursor: pointer;
  }

  .frente :global(.foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .frente :global(.foto.activa) {
    opacity: 1;
  }

  .frente :global(.foto.entrando) {
    animation: foto-entra 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes foto-entra {
    from {
      opacity: 0;
      filter: blur(14px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* Detrás: blanco, con el texto centrado en mitad de la pantalla y, si no
     cabe (móvil pequeño), con scroll propio. */
  .dorso {
    transform: rotateY(180deg);
    display: flex;
    overflow-y: auto;
    background: var(--fondo);
    cursor: pointer;
  }

  .contenido {
    margin: auto;
    width: min(100% - 2 * var(--margen), 36rem);
    padding: 6.5rem 0 3rem;
    text-align: center;
    cursor: auto;
  }

  .biografia {
    font-family: var(--serif);
    font-size: clamp(16px, 1.15vw, 18px);
    font-weight: 300;
    line-height: 1.45;
  }

  .biografia p {
    margin: 0 0 0.8em;
  }

  /* Los datos, en el centro de la pantalla, encima de las fotos, en blanco
     con fusión "diferencia" (pedido de Guzmán): sobre lo claro se ven
     oscuros y sobre lo oscuro, claros, así se leen sobre cualquier foto.
     Van por encima de todas las fotos (que se apilan con z-index). */
  /* Abajo, centrados (pedido de Guzmán; antes en el medio). En el móvil,
     por encima de la barra de Safari. */
  .enlaces {
    position: fixed;
    bottom: calc(3.75rem + env(safe-area-inset-bottom, 0px));
    left: 50%;
    translate: -50% 0;
    z-index: 3;
    transition: opacity 0.35s ease;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    text-align: center;
    white-space: nowrap;
    font-family: var(--serif);
    font-size: calc(1.35em * var(--serif-escala));
    font-weight: 400;
    color: #fff;
    mix-blend-mode: difference;
  }

  .enlaces a {
    color: inherit;
    text-decoration: none;
  }

  :global(html.contacto-girada) .enlaces {
    opacity: 0;
    pointer-events: none;
  }

  .enlaces a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta {
      transition: none;
    }
  }
</style>
