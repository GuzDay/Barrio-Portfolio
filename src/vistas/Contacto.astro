---
// Contacto (rehecha a petición de Guzmán, 21-10-2026), al estilo editorial de
// gilhuybrecht.com/profile pero en blanco, con letra más contenida y la
// estética de la web. En ordenador cabe entera en una pantalla: el texto de
// Pablo ocupa 3/4 del ancho, en la serif, y entra letra a letra (como el
// título de Pintura y Escultura, pero rápido); a la derecha, abajo y en
// pequeño, sus datos y el botón de WhatsApp. En el móvil, uno debajo de otro.
// El título "Contacto" no se ve, pero sigue ahí para buscadores y lectores de
// pantalla.
import Base from '../layouts/Base.astro';
import { ambas, secciones, urlColabora, urlContacto, urlEncargos, urlSeccion, type Idioma } from '../lib/rutas';
import { sitio, urlInstagram, urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const columnas = [
  {
    titulo: t.disciplinas,
    enlaces: [
      { texto: secciones.cuadros.nombre[idioma], url: urlSeccion('cuadros', idioma) },
      { texto: secciones.esculturas.nombre[idioma], url: urlSeccion('esculturas', idioma) },
    ],
  },
  {
    titulo: t.aMedida,
    enlaces: [
      { texto: t.encargos, url: urlEncargos(idioma) },
      { texto: t.colabora, url: urlColabora(idioma) },
    ],
  },
  {
    titulo: t.contacto,
    enlaces: [
      { texto: sitio.telefonoVisible, url: `tel:+${sitio.whatsapp}` },
      { texto: sitio.correo, url: `mailto:${sitio.correo}` },
      { texto: `@${sitio.instagram}`, url: urlInstagram },
    ],
  },
];

// El texto, partido en palabras y letras para que entren una tras otra. Cada
// letra lleva su número (--i), del que sale su retraso. Las palabras van
// enteras en una caja, para que no se corten al final de la línea.
let n = 0;
const parrafos = t.biografia.map((p) => p.split(' ').map((palabra) => [...palabra].map((letra) => ({ letra, i: n++ }))));
---

<Base idioma={idioma} alternativas={ambas(urlContacto)} titulo={t.contacto} descripcion={t.contactoIntro} activa="contacto">
  <h1 class="oculto">{t.contacto}</h1>

  <div class="contacto">
    <div class="biografia">
      {/* Para lectores de pantalla, el texto de corrido; el animado, oculto para ellos. */}
      <div class="oculto">{t.biografia.map((p) => <p>{p}</p>)}</div>
      <div aria-hidden="true">
        {parrafos.map((palabras) => (
          <p>
            {palabras.map((letras, k) => (
              <>
                <span class="palabra">{letras.map(({ letra, i }) => <span class="letra" style={`--i: ${i}`}>{letra}</span>)}</span>
                {k < palabras.length - 1 && ' '}
              </>
            ))}
          </p>
        ))}
      </div>
    </div>

    <div class="datos" style={`--despues: ${n}`}>
      {columnas.map(({ titulo, enlaces }) => (
        <div>
          <h2>{titulo}</h2>
          <ul>
            {enlaces.map(({ texto, url }) => <li><a href={url}>{texto}</a></li>)}
          </ul>
        </div>
      ))}
      <p class="llamada"><a class="boton" href={urlWhatsApp(t.mensajeContacto)}>{t.contactaConmigo}</a></p>
    </div>
  </div>
</Base>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .contacto {
    display: grid;
    gap: 3rem;
    margin-top: 2rem;
  }

  /* El texto de Pablo, en la serif. */
  .biografia {
    font-family: var(--serif);
    font-size: calc(1.3em * var(--serif-escala));
    font-weight: 300;
    line-height: 1.3;
  }

  .biografia p {
    margin: 0 0 0.85em;
  }

  .biografia p:last-child {
    margin-bottom: 0;
  }

  .palabra {
    display: inline-block;
    white-space: nowrap;
  }

  /* Letra a letra, como el título de Pintura y Escultura pero rápido: cada
     una sube un poco y pasa de desenfocada a nítida, 2,5 ms después de la
     anterior (el texto entero, en unos 3 s). */
  .letra {
    display: inline-block;
    animation: letra 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(0.15s + var(--i) * 2.5ms);
  }

  @keyframes letra {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(4px);
    }
  }

  /* Los datos, en pequeño y justificados a la izquierda. Aparecen cuando el
     texto ya va por el final, subiendo apenas (como "Todas / Disponibles"). */
  .datos {
    display: grid;
    align-content: end;
    gap: 1.4rem;
    font-size: 0.9em;
    animation: datos 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--despues) * 2.5ms - 0.6s);
  }

  @keyframes datos {
    from {
      opacity: 0;
      translate: 0 0.4em;
    }
  }

  h2 {
    margin: 0 0 0.35rem;
    font-family: var(--sans);
    font-size: 1em;
    font-weight: 400;
    color: var(--suave);
  }

  .datos ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .datos a:not(.boton) {
    text-decoration: none;
  }

  .datos a:not(.boton):hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .llamada {
    margin: 0.4rem 0 0;
  }

  .llamada .boton {
    padding: 0.65rem 1.1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .letra,
    .datos {
      animation: none;
    }
  }

  /* En ordenador, todo en una pantalla: el texto a 3/4 y los datos a 1/4,
     abajo. El tamaño del texto depende también del alto de la pantalla,
     para que quepa siempre sin scroll. */
  @media (min-width: 900px) {
    :global(main:has(.contacto)) {
      display: flex;
      padding-bottom: 1rem;
    }
    .contacto {
      flex: 1;
      grid-template-columns: 3fr 1fr;
      gap: clamp(2.5rem, 5vw, 6rem);
      margin-top: clamp(0.5rem, 3svh, 2.5rem);
    }
    .biografia {
      font-size: clamp(15px, min(2vw, 3.3svh), 30px);
    }
  }
</style>
