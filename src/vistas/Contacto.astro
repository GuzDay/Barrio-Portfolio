---
// Contacto (rehecha desde cero a petición de Guzmán, 21-10-2026): el texto
// de Pablo en el centro de la pantalla, centrado, y debajo sus enlaces, uno
// tras otro en una lista. El título "Contacto" no se ve, pero sigue ahí para
// buscadores y lectores de pantalla.
import Base from '../layouts/Base.astro';
import { ambas, urlContacto, type Idioma } from '../lib/rutas';
import { sitio, urlInstagram, urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { texto: t.contactaConmigo, url: urlWhatsApp(t.mensajeContacto) },
  { texto: sitio.telefonoVisible, url: `tel:+${sitio.whatsapp}` },
  { texto: sitio.correo, url: `mailto:${sitio.correo}` },
  { texto: `@${sitio.instagram}`, url: urlInstagram },
];
---

<Base idioma={idioma} alternativas={ambas(urlContacto)} titulo={t.contacto} descripcion={t.contactoIntro} activa="contacto">
  <h1 class="oculto">{t.contacto}</h1>

  <div class="contacto">
    <div class="biografia">
      {t.biografia.map((parrafo) => <p>{parrafo}</p>)}
    </div>

    <ul class="enlaces">
      {enlaces.map(({ texto, url }) => <li><a href={url}>{texto}</a></li>)}
    </ul>
  </div>
</Base>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Todo en el centro: a lo ancho y, si cabe, también a lo alto. */
  :global(main:has(.contacto)) {
    display: flex;
  }

  .contacto {
    margin: auto;
    max-width: 40rem;
    padding: 2rem 0;
    text-align: center;
  }

  .biografia {
    font-family: var(--serif);
    font-size: calc(1.25em * var(--serif-escala));
    font-weight: 400;
    line-height: 1.35;
  }

  .biografia p {
    margin: 0 0 0.8em;
  }

  .enlaces {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .enlaces a {
    text-decoration: none;
  }

  .enlaces a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
