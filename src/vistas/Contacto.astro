---
// Contacto (rehecha a petición de Guzmán, 21-10-2026), siguiendo la lámina de
// fotos de Vivien's Creative: mucho aire, fotos de distintos tamaños sueltas
// por una rejilla, cada una con su numerito encima, y el texto de Pablo
// partido en párrafos que acompañan a las fotos, en Newsreader grande y un
// peso más gruesa. Al bajar, cada párrafo entra letra a letra y cada foto se
// descubre. Al final, sus datos y el botón de WhatsApp. El título "Contacto"
// no se ve, pero sigue ahí para buscadores y lectores de pantalla.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import f01 from '../assets/contacto/01.jpg';
import f02 from '../assets/contacto/02.jpg';
import f03 from '../assets/contacto/03.jpg';
import f04 from '../assets/contacto/04.jpg';
import f05 from '../assets/contacto/05.jpg';
import f07 from '../assets/contacto/07.jpg';
import { ambas, secciones, urlColabora, urlContacto, urlEncargos, urlSeccion, type Idioma } from '../lib/rutas';
import { sitio, urlInstagram, urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];

// Una foto recortada a la proporción que le toca (ancho / alto), con sus
// versiones para cada pantalla. Fotos de prueba: sesión de Julián Camarillo.
async function foto(src: ImageMetadata, proporcion: number) {
  const ancho = Math.min(src.width, Math.floor(src.height * proporcion));
  const alto = Math.round(ancho / proporcion);
  const anchos = [400, 700, 1000, 1400].filter((w) => w < ancho).concat(ancho);
  const versiones = await Promise.all(
    anchos.map((w) => getImage({ src, width: w, height: Math.round(w / proporcion), fit: 'cover', format: 'webp' })),
  );
  return {
    src: versiones.at(-1)!.src,
    srcset: versiones.map((v, i) => `${v.src} ${anchos[i]}w`).join(', '),
    ancho,
    alto,
  };
}

// El texto, partido en palabras y letras para que entren una tras otra al
// llegar a cada párrafo. Cada letra lleva su número dentro del párrafo.
const parrafos = t.biografia.map((p) => {
  let n = 0;
  return p.split(' ').map((palabra) => [...palabra].map((letra) => ({ letra, i: n++ })));
});

// La lámina: en qué orden van párrafos y fotos; dónde se colocan en la
// rejilla de 12 columnas del ordenador, en el CSS (en el móvil, todo en una
// columna, con las fotos a distintos anchos).
const p = (indice: number, clase: string) => ({ tipo: 'texto' as const, indice, clase });
const fo = async (src: ImageMetadata, proporcion: number, clase: string) => ({ tipo: 'foto' as const, clase, ...(await foto(src, proporcion)) });
const piezas = [
  p(0, 'p-1'),
  await fo(f01, 3 / 4, 'f-1'),
  await fo(f04, 3 / 4, 'f-2'),
  p(1, 'p-2'),
  await fo(f02, 4 / 3, 'f-3'),
  p(2, 'p-3'),
  await fo(f05, 3 / 4, 'f-4'),
  await fo(f03, 3 / 4, 'f-5'),
  p(3, 'p-4'),
  await fo(f07, 1, 'f-6'),
  p(4, 'p-5'),
];
let numero = 0;

const grupos = [
  {
    titulo: t.contacto,
    enlaces: [
      { texto: sitio.telefonoVisible, url: `tel:+${sitio.whatsapp}` },
      { texto: sitio.correo, url: `mailto:${sitio.correo}` },
      { texto: `@${sitio.instagram}`, url: urlInstagram },
    ],
  },
  {
    titulo: t.disciplinas,
    enlaces: [
      { texto: secciones.cuadros.nombre[idioma], url: urlSeccion('cuadros', idioma) },
      { texto: secciones.esculturas.nombre[idioma], url: urlSeccion('esculturas', idioma) },
    ],
  },
  {
    titulo: t.aMedida,
    enlaces: [
      { texto: t.encargos, url: urlEncargos(idioma) },
      { texto: t.colabora, url: urlColabora(idioma) },
    ],
  },
];
---

<Base idioma={idioma} alternativas={ambas(urlContacto)} titulo={t.contacto} descripcion={t.contactoIntro} activa="contacto">
  <script is:inline>
    // Las piezas esperan escondidas a que se llegue a ellas (ver abajo). Solo
    // si el navegador sabe avisar de eso y no se ha pedido menos movimiento;
    // si no, se ve todo quieto desde el principio.
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.documentElement.classList.add('contacto-anima');
  </script>

  <h1 class="oculto">{t.contacto}</h1>
  {/* Para lectores de pantalla, el texto de corrido; el animado, oculto para ellos. */}
  <div class="oculto">{t.biografia.map((parrafo) => <p>{parrafo}</p>)}</div>

  <div class="lamina">
    {piezas.map((pieza) =>
      pieza.tipo === 'texto' ? (
        <p class:list={['parrafo', 'aparece', pieza.clase]} aria-hidden="true">
          {parrafos[pieza.indice].map((letras, k) => (
            <>
              <span class="palabra">{letras.map(({ letra, i }) => <span class="letra" style={`--i: ${i}`}>{letra}</span>)}</span>
              {k < parrafos[pieza.indice].length - 1 && ' '}
            </>
          ))}
        </p>
      ) : (
        <figure class:list={['foto', 'aparece', pieza.clase]}>
          <figcaption>{String(++numero).padStart(2, '0')}</figcaption>
          <div class="marco" style={`aspect-ratio: ${pieza.ancho} / ${pieza.alto}`}>
            <img
              src={pieza.src}
              srcset={pieza.srcset}
              sizes="(min-width: 900px) 33vw, 70vw"
              width={pieza.ancho}
              height={pieza.alto}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      ),
    )}

    <div class="datos aparece">
      {grupos.map(({ titulo, enlaces }) => (
        <div>
          <h2>{titulo}</h2>
          <ul>
            {enlaces.map(({ texto, url }) => <li><a href={url}>{texto}</a></li>)}
          </ul>
        </div>
      ))}
      <p class="llamada"><a class="boton" href={urlWhatsApp(t.mensajeContacto)}>{t.contactaConmigo}</a></p>
    </div>
  </div>
</Base>

<script>
  // Al llegar a cada pieza (un poco antes de que asome del todo), se marca
  // como vista y hace su entrada (ver el CSS). Solo una vez.
  if (document.documentElement.classList.contains('contacto-anima')) {
    const ver = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('visto');
          ver.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll('.aparece').forEach((el) => ver.observe(el));
  }
</script>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- La lámina ----------
     Una columna en el móvil; en ordenador, una rejilla de 12 columnas con
     mucho aire entre filas, donde cada pieza tiene su sitio (ver abajo). */
  .lamina {
    display: grid;
    gap: 3.5rem;
    padding: 2rem 0 2rem;
  }

  /* El texto de Pablo: Newsreader grande y un peso más gruesa que el resto
     de la web (500 en vez de 400). */
  .parrafo {
    margin: 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.7rem, 3.4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .palabra {
    display: inline-block;
    white-space: nowrap;
  }

  .letra {
    display: inline-block;
  }

  .foto {
    margin: 0;
  }

  /* El numerito encima de cada foto, pequeño, como en la referencia. */
  figcaption {
    margin-bottom: 0.4rem;
    font-size: 0.7em;
    color: var(--suave);
    font-variant-numeric: tabular-nums;
  }

  .marco {
    overflow: hidden;
    background: var(--vacio);
  }

  .marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* En el móvil, las fotos a distintos anchos y alternando lado. */
  .f-1,
  .f-4 {
    width: 62%;
    justify-self: end;
  }
  .f-2,
  .f-5 {
    width: 78%;
  }
  .f-3 {
    width: 100%;
  }
  .f-6 {
    width: 50%;
    justify-self: center;
  }

  /* ---------- Los datos, al final ---------- */
  .datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 1.25rem 2.5rem;
    margin-top: 2rem;
    font-size: 0.9em;
    line-height: 1.4;
  }

  .datos > div:first-child {
    grid-row: span 2;
  }

  h2 {
    margin: 0 0 0.25rem;
    font-family: var(--sans);
    font-size: 1em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .datos ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .datos a:not(.boton) {
    text-decoration: none;
  }

  .datos a:not(.boton):hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .llamada {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
  }

  /* ---------- Ordenador: la rejilla ---------- */
  @media (min-width: 900px) {
    .lamina {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
      row-gap: clamp(4rem, 12vh, 9rem);
      padding-top: clamp(1.5rem, 6vh, 4rem);
    }
    .lamina > * {
      width: auto;
      justify-self: stretch;
    }
    /* 1: el primer párrafo a lo ancho y una foto pequeña a la derecha, algo
       más abajo. */
    .p-1 {
      grid-column: 1 / 10;
      align-self: start;
    }
    .f-1 {
      grid-column: 10 / 13;
      margin-top: 8rem;
    }
    /* 2: una foto mediana a la izquierda y el segundo párrafo a su lado. */
    .f-2 {
      grid-column: 1 / 5;
    }
    .p-2 {
      grid-column: 6 / 13;
      align-self: center;
    }
    /* 3: una foto apaisada en el centro y el tercer párrafo, corto, debajo
       y desplazado. */
    .f-3 {
      grid-column: 4 / 10;
    }
    .p-3 {
      grid-column: 3 / 12;
    }
    /* 4: dos fotos sueltas, a distinta altura, y el párrafo largo. */
    .f-4 {
      grid-column: 2 / 5;
    }
    .f-5 {
      grid-column: 8 / 11;
      margin-top: 10rem;
    }
    .p-4 {
      grid-column: 1 / 11;
    }
    /* 5: el último párrafo y una foto cuadrada a la derecha. */
    .p-5 {
      grid-column: 1 / 8;
      align-self: end;
    }
    .f-6 {
      grid-column: 9 / 13;
    }
    .datos {
      grid-column: 1 / 13;
      grid-template-columns: repeat(3, max-content) 1fr;
      align-items: start;
      column-gap: clamp(2rem, 5vw, 5rem);
      margin-top: 3rem;
      font-size: 0.85em;
    }
    .datos > div:first-child {
      grid-row: auto;
    }
    .llamada {
      grid-column: auto;
      justify-self: end;
      align-self: end;
      margin: 0;
    }
  }

  /* ---------- Entradas al hacer scroll ----------
     Solo si el navegador puede (ver el script del principio). */
  :global(html.contacto-anima) .aparece:not(.visto) .letra,
  :global(html.contacto-anima) .datos.aparece:not(.visto) {
    opacity: 0;
  }

  /* Párrafos: letra a letra, rápido (como el título de Pintura y Escultura). */
  :global(html.contacto-anima) .parrafo.visto .letra {
    animation: letra 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--i) * 6ms);
  }

  @keyframes letra {
    from {
      opacity: 0;
      transform: translateY(0.3em);
      filter: blur(6px);
    }
  }

  /* Fotos: se descubren de abajo arriba mientras se asienta un zoom suave;
     el numerito, un poco antes. */
  :global(html.contacto-anima) .foto:not(.visto) .marco {
    clip-path: inset(100% 0 0 0);
  }
  :global(html.contacto-anima) .foto:not(.visto) figcaption {
    opacity: 0;
  }
  :global(html.contacto-anima) .foto.visto .marco {
    animation: descubrir 1.2s cubic-bezier(0.65, 0, 0.35, 1) backwards;
  }
  :global(html.contacto-anima) .foto.visto img {
    animation: asentar 2s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  :global(html.contacto-anima) .foto.visto figcaption {
    animation: fundir 0.6s ease backwards;
  }

  @keyframes descubrir {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes asentar {
    from {
      transform: scale(1.12);
    }
  }

  @keyframes fundir {
    from {
      opacity: 0;
    }
  }

  /* Los datos, subiendo apenas (como "Todas / Disponibles"). */
  :global(html.contacto-anima) .datos.visto {
    animation: datos 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  @keyframes datos {
    from {
      opacity: 0;
      translate: 0 0.6em;
    }
  }
</style>
