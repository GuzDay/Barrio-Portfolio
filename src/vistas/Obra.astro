---
// Página de una obra, sin cabecera ni pie (pedido de Guzmán): sus fotos en
// un carrusel vertical 3:4 que se arrastra a los lados, con flechas a media
// altura y la obra anterior / siguiente debajo; arriba a la izquierda,
// "Cerrar", que vuelve a la sección; al lado, la ficha con el botón para preguntar
// por WhatsApp. En ordenador ocupa justo la pantalla, sin scroll, con la
// foto centrada en vertical.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EstadoObra from '../components/EstadoObra.astro';
import { marco34 } from '../lib/fotos';
import { ficha, obrasDe } from '../lib/obras';
import { ambas, secciones, urlObra, urlSeccion, type Idioma, type Seccion } from '../lib/rutas';
import { urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  seccion: Seccion;
  id: string;
}

const { idioma, seccion, id } = Astro.props;
const t = textos[idioma];
const obras = await obrasDe(seccion);
const pos = obras.findIndex((o) => o.id === id);
const obra = obras[pos]!;
const anterior = obras[pos - 1];
const siguiente = obras[pos + 1];
const f = ficha(obra, idioma);
const nombreSeccion = secciones[seccion].nombre[idioma];
const direccion = new URL(urlObra(seccion, id, idioma), Astro.site).href;
---

<Base
  idioma={idioma}
  alternativas={ambas((i) => urlObra(seccion, id, i))}
  titulo={f.titulo}
  descripcion={f.texto}
  activa={seccion}
  sinCabecera
>
  <a class="cerrar" href={urlSeccion(seccion, idioma)} title={t.volver(nombreSeccion)}>{t.cerrar}</a>
  <article class="obra">
    <div class="columna-fotos">
    <div class="carrusel" data-varias={f.fotos.length > 1 ? '' : undefined}>
      <ul class="pista" aria-label={t.fotos} tabindex="0">
        {f.fotos.map((foto, i) => (
          <li>
            <Image
              src={foto}
              alt={i === 0 ? f.titulo : ''}
              {...marco34(foto, [600, 900, 1200, 1800, 2400])}
              sizes="(min-width: 900px) 66vh, 92vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              draggable="false"
            />
          </li>
        ))}
      </ul>
      {f.fotos.length > 1 && (
        <>
          <button class="flecha anterior" type="button" aria-label={t.fotoAnterior} disabled>
            <span aria-hidden="true">‹</span>
          </button>
          <button class="flecha siguiente" type="button" aria-label={t.fotoSiguiente}>
            <span aria-hidden="true">›</span>
          </button>
        </>
      )}
    </div>
      <nav class="vecinas">
        {anterior ? <a href={urlObra(seccion, anterior.id, idioma)}>← {t.anterior}</a> : <span />}
        {siguiente && <a href={urlObra(seccion, siguiente.id, idioma)}>{t.siguiente} →</a>}
      </nav>
    </div>
    <div class="ficha">
      <h1>{f.titulo}</h1>
      <ul class="datos">
        {[f.tecnica, f.medidas, f.anio].filter(Boolean).map((dato) => <li>{dato}</li>)}
      </ul>
      {f.texto && <p class="texto">{f.texto}</p>}
      <EstadoObra idioma={idioma} vendida={f.vendida} class="estado-ficha" />
      {!f.vendida && (
        <a class="boton" href={urlWhatsApp(t.mensajeObra(f.titulo, direccion))}>{t.preguntarObra}</a>
      )}
    </div>
  </article>
</Base>

<script>
  // Esc sale de la obra y vuelve a su sección, como "Cerrar"
  // (pedido de Guzmán).
  // Transición con la galería (ver Galeria.astro): la foto visible es la que
  // vuela, con el nombre "foto-obra". Solo hacia o desde su propia sección.
  const seccion = () => new URL(document.querySelector<HTMLAnchorElement>('.cerrar')!.href).pathname;
  const esSeccion = (url: string) => {
    try {
      return new URL(url, location.href).pathname === seccion();
    } catch {
      return false;
    }
  };
  const fotoVisible = () => {
    const pista = document.querySelector<HTMLElement>('.pista')!;
    const i = Math.round(pista.scrollLeft / pista.clientWidth);
    return pista.querySelectorAll<HTMLElement>('img')[i];
  };
  addEventListener('pageswap', (e: any) => {
    if (!e.viewTransition) return;
    if (!esSeccion(e.activation?.entry?.url ?? '')) return e.viewTransition.skipTransition();
    const img = fotoVisible();
    if (img) img.style.viewTransitionName = 'foto-obra';
  });
  addEventListener('pagereveal', (e: any) => {
    if (!e.viewTransition) return;
    const desde = (globalThis as any).navigation?.activation?.from?.url ?? document.referrer;
    if (!esSeccion(desde)) return e.viewTransition.skipTransition();
    const img = fotoVisible();
    if (img) img.style.viewTransitionName = 'foto-obra';
    e.viewTransition.finished.finally(() => img && (img.style.viewTransitionName = ''));
  });

  // Esc pulsa el propio enlace "Cerrar", para que haga exactamente lo mismo
  // que el botón (misma navegación, misma transición, misma altura al volver).
  // Se navega al SOLTAR la tecla: en Chrome, Esc también es "detener la
  // carga", y si se navegaba al pulsarla, el navegador cortaba en seco la
  // vuelta recién empezada (hacía falta darle varias veces).
  let escPulsada = false;
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || e.defaultPrevented) return;
    e.preventDefault();
    escPulsada = true;
  });
  addEventListener('keyup', (e) => {
    if (e.key !== 'Escape' || !escPulsada) return;
    escPulsada = false;
    document.querySelector<HTMLAnchorElement>('.cerrar')?.click();
  });

  // Carrusel: la pista es una fila de fotos con desplazamiento lateral y
  // "imán" a cada foto (scroll-snap), así que el dedo y el trackpad ya
  // funcionan solos. Aquí se añaden las flechas y arrastrar con el ratón.
  for (const carrusel of document.querySelectorAll<HTMLElement>('.carrusel[data-varias]')) {
    const pista = carrusel.querySelector<HTMLElement>('.pista')!;
    const ant = carrusel.querySelector<HTMLButtonElement>('.anterior')!;
    const sig = carrusel.querySelector<HTMLButtonElement>('.siguiente')!;
    const actual = () => Math.round(pista.scrollLeft / pista.clientWidth);
    const total = pista.children.length;
    const ir = (i: number) =>
      pista.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * pista.clientWidth, behavior: 'smooth' });
    const flechas = () => {
      const i = actual();
      ant.disabled = i <= 0;
      sig.disabled = i >= total - 1;
    };
    ant.addEventListener('click', () => ir(actual() - 1));
    sig.addEventListener('click', () => ir(actual() + 1));
    pista.addEventListener('scroll', flechas, { passive: true });
    pista.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') (e.preventDefault(), ir(actual() - 1));
      if (e.key === 'ArrowRight') (e.preventDefault(), ir(actual() + 1));
    });
    flechas();

    // Arrastrar con el ratón (el dedo ya lo hace el navegador). Mientras se
    // arrastra se quita el imán; al soltar, se va a la foto más cercana, o a
    // la siguiente si se ha arrastrado un trozo hacia ese lado.
    let inicioX = 0;
    let inicioScroll = 0;
    let arrastrando = false;
    pista.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      arrastrando = true;
      inicioX = e.clientX;
      inicioScroll = pista.scrollLeft;
      pista.classList.add('arrastrando');
      pista.setPointerCapture(e.pointerId);
    });
    pista.addEventListener('pointermove', (e) => {
      if (arrastrando) pista.scrollLeft = inicioScroll - (e.clientX - inicioX);
    });
    let fueArrastre = false;
    const soltar = (e: PointerEvent) => {
      if (!arrastrando) return;
      arrastrando = false;
      pista.classList.remove('arrastrando');
      const movido = e.clientX - inicioX;
      fueArrastre = Math.abs(movido) > 5;
      if (!fueArrastre) return; // un clic: lo resuelve el "click" de abajo
      const desde = Math.round(inicioScroll / pista.clientWidth);
      const umbral = pista.clientWidth * 0.12;
      ir(movido < -umbral ? desde + 1 : movido > umbral ? desde - 1 : desde);
    };
    pista.addEventListener('pointerup', soltar);
    pista.addEventListener('pointercancel', soltar);

    // Pulsar en la foto (sin arrastrar) pasa de foto: en la mitad derecha, a
    // la siguiente; en la izquierda, a la anterior (pedido de Guzmán). Vale
    // para el ratón y para un toque con el dedo. El cursor lo indica.
    pista.addEventListener('click', (e) => {
      if (fueArrastre) return void (fueArrastre = false);
      const r = pista.getBoundingClientRect();
      ir(actual() + (e.clientX > r.left + r.width / 2 ? 1 : -1));
    });
    pista.addEventListener('mousemove', (e) => {
      if (arrastrando) return;
      const r = pista.getBoundingClientRect();
      const derecha = e.clientX > r.left + r.width / 2;
      const i = actual();
      const puede = derecha ? i < total - 1 : i > 0;
      pista.style.cursor = puede ? (derecha ? 'e-resize' : 'w-resize') : 'default';
    });
  }
</script>

<style>
  .vecinas {
    display: flex;
    justify-content: space-between;
    margin: 1rem 0 0;
    font-size: 0.9em;
  }

  /* "Cerrar": arriba a la izquierda, alineado con el margen de la web. En
     el móvil va encima de la foto; en ordenador, fijo en la esquina. */
  .cerrar {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.9em;
  }

  .cerrar,
  .vecinas a {
    color: var(--suave);
    text-decoration: none;
  }

  .cerrar:hover,
  .vecinas a:hover {
    color: var(--texto);
  }

  .obra {
    display: grid;
    gap: 2rem;
  }

  /* ---------- Carrusel de fotos ---------- */

  /* Formato vertical 3:4 (como las tarjetas de la galería), con la foto
     recortada para llenarlo (pedido de Guzmán). El alto, limitado a lo que
     cabe en la pantalla bajo la cabecera, manda sobre el ancho. */
  .obra {
    /* Sin cabecera: la foto puede ocupar casi todo el alto, dejando sitio
       arriba y para "Anterior / Siguiente" debajo. */
    --alto: min(calc(100svh - 150px), 860px);
  }

  .carrusel {
    position: relative;
    min-width: 0;
    width: min(100%, calc(var(--alto) * 0.75));
  }

  .pista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    background: var(--vacio);
  }

  .pista::-webkit-scrollbar {
    display: none;
  }

  .pista li {
    flex: 0 0 100%;
    aspect-ratio: 3 / 4;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pista img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .carrusel[data-varias] .pista {
    cursor: grab;
  }

  .pista.arrastrando {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  /* Flechas a media altura, sin recuadro: en blanco con fusión "exclusión"
     (como la firma), así se ven sobre cualquier color de la foto. */
  .flecha {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 2.75rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    padding: 0 0 4px;
    border: 0;
    background: none;
    color: #fff;
    mix-blend-mode: exclusion;
    font: 200 3rem/1 var(--serif);
    cursor: pointer;
    transition:
      opacity 0.25s ease,
      scale 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .flecha:hover {
    scale: 1.15;
  }

  .flecha:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .anterior {
    left: 4px;
  }

  .siguiente {
    right: 4px;
  }

  @media (max-width: 899px) {
    .obra {
      --alto: min(72svh, 600px);
    }
    .flecha {
      width: 2.25rem;
      height: 3rem;
      font-size: 2.5rem;
    }
    .anterior {
      left: 0;
    }
    .siguiente {
      right: 0;
    }
  }

  /* Título de la obra algo más pequeño que el de las páginas de sección
     (pedido de Guzmán): 32 px en ordenador y 23 en móvil, antes 38,4 y 25,6. */
  .ficha h1 {
    margin: 0 0 0.75rem;
    font-size: calc(2em * var(--serif-escala));
  }

  @media (max-width: 899px) {
    .ficha h1 {
      font-size: calc(1.44em * var(--serif-escala));
    }
  }

  .datos {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    color: var(--suave);
  }

  .texto {
    margin: 0 0 1.25rem;
  }

  .ficha :global(.estado-ficha) {
    display: flex;
    width: fit-content;
    margin: 0 0 1.25rem;
    font-weight: 400;
  }

  /* En ordenador (pedido de Guzmán): el carrusel 3:4 centrado en la
     pantalla, en la columna del medio de tres iguales a los lados; la ficha
     en la columna de la derecha, separada de la foto, y empezando algo por
     debajo del borde de arriba de la foto (un 18 % de su alto; antes 12 %, Guzmán la quiso algo más abajo). */
  @media (min-width: 900px) {
    /* Sin scroll: la página mide justo la pantalla y la foto va centrada en
       vertical, con el mismo margen arriba que abajo (--hueco-v). "Anterior /
       Siguiente" cuelga debajo de la foto, dentro de ese margen de abajo. */
    :global(body:has(.obra)) {
      height: 100svh;
      overflow: hidden;
    }
    :global(main:has(.obra)) {
      padding-block: 0;
    }
    .obra {
      --hueco-v: clamp(2.5rem, 7svh, 4.5rem);
      --alto: calc(100svh - 2 * var(--hueco-v));
      height: 100svh;
      /* Columna de las fotos con el ancho exacto del 3:4 (como mucho el
         50 %); si fuera "auto", se estiraba con la fila de fotos. */
      grid-template-columns: minmax(0, 1fr) min(calc(var(--alto) * 0.75), 50%) minmax(0, 1fr);
      gap: 0;
      align-items: center;
    }
    .columna-fotos {
      grid-column: 2;
      position: relative;
    }
    .vecinas {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
    }
    .cerrar {
      position: fixed;
      top: 1.5rem;
      left: var(--lateral);
      margin: 0;
      z-index: 1;
    }
    .ficha {
      grid-column: 3;
      align-self: start;
      margin-top: calc(var(--hueco-v) + var(--alto) * 0.18);
      padding-left: clamp(2rem, 6vw, 6rem);
      max-width: 26rem;
    }
  }
</style>

<style is:global>
  /* Activa las transiciones entre esta página y la otra (galería ↔ obra).
     Hace falta en las dos; el resto de páginas no lo llevan. */
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>
