---
// Página de una obra, sin cabecera ni pie (pedido de Guzmán): sus fotos en
// un carrusel vertical 3:4 que se arrastra a los lados o se pasa pulsando
// en su mitad derecha o izquierda, con puntitos debajo; "Cerrar" (vuelve a
// la sección) arriba a la derecha; al lado, la ficha con el botón para
// preguntar por WhatsApp. En ordenador ocupa justo la pantalla, sin scroll, con la
// foto centrada en vertical.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EstadoObra from '../components/EstadoObra.astro';
import { marco34 } from '../lib/fotos';
import { ficha, obrasDe } from '../lib/obras';
import { ambas, secciones, urlObra, urlSeccion, type Idioma, type Seccion } from '../lib/rutas';
import { urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  seccion: Seccion;
  id: string;
}

const { idioma, seccion, id } = Astro.props;
const t = textos[idioma];
const obras = await obrasDe(seccion);
const pos = obras.findIndex((o) => o.id === id);
const obra = obras[pos]!;
// La obra anterior y la siguiente de la sección, para las flechas de los
// lados de la pantalla (en ordenador).
const anterior = obras[pos - 1];
const siguiente = obras[pos + 1];
const f = ficha(obra, idioma);
const nombreSeccion = secciones[seccion].nombre[idioma];
const direccion = new URL(urlObra(seccion, id, idioma), Astro.site).href;
---

<Base
  idioma={idioma}
  alternativas={ambas((i) => urlObra(seccion, id, i))}
  titulo={f.titulo}
  descripcion={f.texto}
  activa={seccion}
  sinCabecera
>
  <script is:inline>
    // Entrada de la obra (ver "Entrada" en el CSS). Se decide antes de
    // pintar: con movimiento reducido, nada. La foto solo hace su entrada si
    // no se llega desde la galería de la sección: desde ahí ya llega volando
    // desde su tarjeta (transición entre páginas).
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var html = document.documentElement;
      html.classList.add('obra-anima');
      var desde = '';
      try {
        desde = new URL(document.referrer).pathname;
      } catch (e) {}
      var seccion = location.pathname.replace(/[^/]+\/$/, '');
      var vuela = desde === seccion && 'onpagereveal' in window;
      if (!vuela) html.classList.add('obra-anima-foto');
    })();
  </script>

  {/* Pasar de obra: flechas a los lados de la pantalla, en ordenador
      (pedido de Guzmán, 21-10-2026); también con las flechas del teclado y,
      en el móvil, deslizando el dedo (ver el script). */}
  <nav class="vecinas" aria-label={nombreSeccion}>
    {anterior && <a class="vecina anterior-obra" href={urlObra(seccion, anterior.id, idioma)} aria-label={`${t.anterior}: ${ficha(anterior, idioma).titulo}`}><svg viewBox="0 0 12 22" aria-hidden="true"><path d="M11 1 1 11l10 10" /></svg></a>}
    {siguiente && <a class="vecina siguiente-obra" href={urlObra(seccion, siguiente.id, idioma)} aria-label={`${t.siguiente}: ${ficha(siguiente, idioma).titulo}`}><svg viewBox="0 0 12 22" aria-hidden="true"><path d="m1 1 10 10L1 21" /></svg></a>}
  </nav>

  {/* "Cerrar", arriba a la derecha de la página (pedido de Guzmán). */}
  <a class="cerrar" href={urlSeccion(seccion, idioma)} title={t.volver(nombreSeccion)}>{t.cerrar}</a>

  <article class="obra">
    <div class="columna-fotos">
    <div class="carrusel" data-varias={f.fotos.length > 1 ? '' : undefined}>
      <ul class="pista" aria-label={t.fotos} tabindex="0">
        {f.fotos.map((foto, i) => (
          <li>
            <Image
              src={foto}
              alt={i === 0 ? f.titulo : ''}
              {...marco34(foto, [600, 900, 1200, 1800, 2400])}
              sizes="(min-width: 900px) 66vh, 92vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              draggable="false"
            />
          </li>
        ))}
      </ul>
    </div>
      {/* Puntitos bajo la foto, como en Instagram: cuántas fotos hay y en
          cuál estás (pedido de Guzmán). Pulsar uno lleva a esa foto. */}
      {f.fotos.length > 1 && (
        <div class="puntos">
          {f.fotos.map((_, i) => (
            <button type="button" class="punto" aria-label={`${t.fotos} ${i + 1}/${f.fotos.length}`} aria-current={i === 0 ? 'true' : undefined} />
          ))}
        </div>
      )}
    </div>
    <div class="ficha">
      <h1>{f.titulo}</h1>
      <ul class="datos">
        {/* Medidas y técnica. El año ya no se enseña (pedido de Pablo,
            29-10-2026), aunque sigue en las fichas y en el panel. */}
        {[f.medidas, f.tecnica].filter(Boolean).map((dato, i) => <li style={`--n: ${i}`}>{dato}</li>)}
      </ul>
      {f.texto && <p class="texto">{f.texto}</p>}
      <EstadoObra idioma={idioma} vendida={f.vendida} class="estado-ficha" />
      {!f.vendida && (
        <a class="boton" href={urlWhatsApp(t.mensajeObra(f.titulo, direccion))}>{t.preguntarObra}</a>
      )}
    </div>
  </article>
</Base>

<script>
  // Esc sale de la obra y vuelve a su sección, como "Cerrar"
  // (pedido de Guzmán).
  // Transición con la galería (ver Galeria.astro): la foto visible es la que
  // vuela, con el nombre "foto-obra". Solo hacia o desde su propia sección.
  const seccion = () => new URL(document.querySelector<HTMLAnchorElement>('.cerrar')!.href).pathname;
  const esSeccion = (url: string) => {
    try {
      return new URL(url, location.href).pathname === seccion();
    } catch {
      return false;
    }
  };
  const fotoVisible = () => {
    const pista = document.querySelector<HTMLElement>('.pista')!;
    const i = Math.round(pista.scrollLeft / pista.clientWidth);
    return pista.querySelectorAll<HTMLElement>('img')[i];
  };
  addEventListener('pageswap', (e: any) => {
    if (!e.viewTransition) return;
    if (!esSeccion(e.activation?.entry?.url ?? '')) return e.viewTransition.skipTransition();
    const img = fotoVisible();
    if (img) img.style.viewTransitionName = 'foto-obra';
  });
  addEventListener('pagereveal', (e: any) => {
    if (!e.viewTransition) return;
    const desde = (globalThis as any).navigation?.activation?.from?.url ?? document.referrer;
    if (!esSeccion(desde)) return e.viewTransition.skipTransition();
    const img = fotoVisible();
    if (img) img.style.viewTransitionName = 'foto-obra';
    e.viewTransition.finished.finally(() => img && (img.style.viewTransitionName = ''));
  });

  // Esc pulsa el propio enlace "Cerrar", para que haga exactamente lo mismo
  // que el botón (misma navegación, misma transición, misma altura al volver).
  // Se navega al SOLTAR la tecla: en Chrome, Esc también es "detener la
  // carga", y si se navegaba al pulsarla, el navegador cortaba en seco la
  // vuelta recién empezada (hacía falta darle varias veces).
  let escPulsada = false;
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || e.defaultPrevented) return;
    e.preventDefault();
    escPulsada = true;
  });
  addEventListener('keyup', (e) => {
    if (e.key !== 'Escape' || !escPulsada) return;
    escPulsada = false;
    document.querySelector<HTMLAnchorElement>('.cerrar')?.click();
  });

  // Pasar de obra sin las flechas de los lados (pedido de Guzmán):
  // - Con las flechas izquierda / derecha del teclado. Si la foto tiene el
  //   foco (se ha pulsado en ella), las flechas pasan de foto, como antes.
  // - En el móvil, deslizando el dedo a un lado, fuera de un carrusel de
  //   varias fotos (ahí el dedo pasa de foto). Hacia la izquierda, la
  //   siguiente; hacia la derecha, la anterior.
  const vecina = (cual: 'anterior' | 'siguiente') =>
    document.querySelector<HTMLAnchorElement>(cual === 'anterior' ? '.anterior-obra' : '.siguiente-obra');
  const irA = (cual: 'anterior' | 'siguiente') => {
    const a = vecina(cual);
    if (a) location.href = a.href;
  };
  addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.altKey || e.metaKey || e.ctrlKey || e.shiftKey) return;
    if (e.key === 'ArrowLeft') irA('anterior');
    if (e.key === 'ArrowRight') irA('siguiente');
  });
  let toque: { x: number; y: number; t: number } | null = null;
  addEventListener(
    'touchstart',
    (e) => {
      const fuera = !(e.target as Element).closest('.carrusel[data-varias]');
      toque = e.touches.length === 1 && fuera ? { x: e.touches[0].clientX, y: e.touches[0].clientY, t: Date.now() } : null;
    },
    { passive: true },
  );
  addEventListener(
    'touchend',
    (e) => {
      if (!toque) return;
      const dx = e.changedTouches[0].clientX - toque.x;
      const dy = e.changedTouches[0].clientY - toque.y;
      const rapido = Date.now() - toque.t < 700;
      toque = null;
      if (rapido && Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.5) irA(dx < 0 ? 'siguiente' : 'anterior');
    },
    { passive: true },
  );

  // Carrusel: la pista es una fila de fotos con desplazamiento lateral y
  // "imán" a cada foto (scroll-snap), así que el dedo y el trackpad ya
  // funcionan solos. Aquí se añaden los puntitos, el teclado, arrastrar con
  // el ratón y pulsar en una mitad (sin flechas dentro de la foto: las quitó
  // Guzmán).
  for (const carrusel of document.querySelectorAll<HTMLElement>('.carrusel[data-varias]')) {
    const pista = carrusel.querySelector<HTMLElement>('.pista')!;
    const actual = () => Math.round(pista.scrollLeft / pista.clientWidth);
    const total = pista.children.length;
    const ir = (i: number) =>
      pista.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * pista.clientWidth, behavior: 'smooth' });
    const puntos = [...(carrusel.parentElement!.querySelectorAll<HTMLButtonElement>('.punto') ?? [])];
    puntos.forEach((p, i) => p.addEventListener('click', () => ir(i)));
    const marcar = () => {
      const i = actual();
      puntos.forEach((p, k) => (k === i ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
    };
    pista.addEventListener('scroll', marcar, { passive: true });
    pista.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') (e.preventDefault(), ir(actual() - 1));
      if (e.key === 'ArrowRight') (e.preventDefault(), ir(actual() + 1));
    });
    marcar();

    // Arrastrar con el ratón (el dedo ya lo hace el navegador). Mientras se
    // arrastra se quita el imán; al soltar, se va a la foto más cercana, o a
    // la siguiente si se ha arrastrado un trozo hacia ese lado.
    let inicioX = 0;
    let inicioScroll = 0;
    let arrastrando = false;
    pista.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      arrastrando = true;
      inicioX = e.clientX;
      inicioScroll = pista.scrollLeft;
      pista.classList.add('arrastrando');
      pista.setPointerCapture(e.pointerId);
    });
    pista.addEventListener('pointermove', (e) => {
      if (arrastrando) pista.scrollLeft = inicioScroll - (e.clientX - inicioX);
    });
    let fueArrastre = false;
    const soltar = (e: PointerEvent) => {
      if (!arrastrando) return;
      arrastrando = false;
      pista.classList.remove('arrastrando');
      const movido = e.clientX - inicioX;
      fueArrastre = Math.abs(movido) > 5;
      if (!fueArrastre) return; // un clic: lo resuelve el "click" de abajo
      const desde = Math.round(inicioScroll / pista.clientWidth);
      const umbral = pista.clientWidth * 0.12;
      ir(movido < -umbral ? desde + 1 : movido > umbral ? desde - 1 : desde);
    };
    pista.addEventListener('pointerup', soltar);
    pista.addEventListener('pointercancel', soltar);

    // Pulsar en la foto (sin arrastrar) pasa de foto: en la mitad derecha, a
    // la siguiente; en la izquierda, a la anterior (pedido de Guzmán). Vale
    // para el ratón y para un toque con el dedo. El cursor lo indica.
    pista.addEventListener('click', (e) => {
      if (fueArrastre) return void (fueArrastre = false);
      const r = pista.getBoundingClientRect();
      ir(actual() + (e.clientX > r.left + r.width / 2 ? 1 : -1));
    });
    pista.addEventListener('mousemove', (e) => {
      if (arrastrando) return;
      const r = pista.getBoundingClientRect();
      const derecha = e.clientX > r.left + r.width / 2;
      const i = actual();
      const puede = derecha ? i < total - 1 : i > 0;
      pista.style.cursor = puede ? (derecha ? 'e-resize' : 'w-resize') : 'default';
    });
  }
</script>

<style>
  /* ---------- Entrada de la obra ----------
     Muy ligera (pedido de Guzmán): todo entra en bloque, uno tras otro,
     solo con opacidad y desplazamiento, que el navegador anima sin
     esfuerzo. El título también (letra a letra tardaba en verse). Lo
     activa el script del principio. */
  :global(html.obra-anima) .ficha h1 {
    animation: obra-sube 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  :global(html.obra-anima) .ficha .datos li,
  :global(html.obra-anima) .ficha .texto,
  :global(html.obra-anima) .ficha :global(.estado-ficha),
  :global(html.obra-anima) .ficha .boton,
  :global(html.obra-anima) .cerrar,
  :global(html.obra-anima) .vecina {
    animation: obra-sube 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  :global(html.obra-anima) .ficha .datos li {
    animation-delay: calc(0.1s + var(--n) * 50ms);
  }
  :global(html.obra-anima) .ficha .texto {
    animation-delay: 0.22s;
  }
  :global(html.obra-anima) .ficha :global(.estado-ficha) {
    animation-delay: 0.3s;
  }
  :global(html.obra-anima) .ficha .boton {
    animation-delay: 0.36s;
  }
  :global(html.obra-anima) .cerrar,
  :global(html.obra-anima) .vecina {
    animation-name: obra-funde;
    animation-delay: 0.15s;
  }

  /* La foto: aparece con un zoom suave, como la portada (solo opacidad y
     escala). Desde la galería no: allí llega volando desde su tarjeta. */
  :global(html.obra-anima-foto) .carrusel {
    animation: obra-foto 1s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  @keyframes obra-sube {
    from {
      opacity: 0;
      translate: 0 0.6em;
    }
  }

  @keyframes obra-funde {
    from {
      opacity: 0;
    }
  }

  @keyframes obra-foto {
    from {
      opacity: 0;
      scale: 1.03;
    }
  }

  /* "Cerrar", encima de la foto y alineado con su borde derecho (pedido de
     Guzmán). En ordenador cuelga en el margen de arriba. */
  /* "Cerrar", arriba a la derecha de la página, a la altura y con el
     margen de la cabecera del resto de la web. */
  .cerrar {
    position: absolute;
    top: 1.4rem;
    right: var(--lateral);
    z-index: 5;
    font-size: 0.9em;
  }

  /* Los puntitos: grises, el de la foto que se ve, negro. */
  .puntos {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 0.9rem;
  }

  .punto {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--linea);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      scale 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .punto[aria-current] {
    background: var(--texto);
  }

  .punto:hover {
    scale: 1.3;
  }

  .cerrar {
    color: var(--suave);
    text-decoration: none;
  }

  .cerrar:hover {
    color: var(--texto);
  }

  .obra {
    display: grid;
    gap: 2rem;
  }

  /* ---------- Carrusel de fotos ---------- */

  /* Formato vertical 3:4 (como las tarjetas de la galería), con la foto
     recortada para llenarlo (pedido de Guzmán). El alto, limitado a lo que
     cabe en la pantalla bajo la cabecera, manda sobre el ancho. */
  .obra {
    /* Sin cabecera: la foto puede ocupar casi todo el alto, dejando sitio
       arriba para "Cerrar" y algo de aire debajo. */
    --alto: min(calc(100svh - 150px), 860px);
  }

  .carrusel {
    position: relative;
    min-width: 0;
    width: min(100%, calc(var(--alto) * 0.75));
  }

  .pista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    background: var(--vacio);
  }

  .pista::-webkit-scrollbar {
    display: none;
  }

  .pista li {
    flex: 0 0 100%;
    aspect-ratio: 3 / 4;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pista img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .carrusel[data-varias] .pista {
    cursor: grab;
  }

  .pista.arrastrando {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .vecina svg {
    width: 12px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  /* Las flechas para pasar de obra: muy a los lados de la pantalla, a
     media altura, del mismo trazo pero en gris, que se oscurece al pasar
     el ratón. Solo en ordenador. */
  /* En el móvil no se ven (allí se pasa de obra deslizando el dedo), pero
     siguen en la página: de ellas salen las direcciones. */
  .vecinas {
    display: none;
  }

  @media (min-width: 900px) {
    .vecinas {
      display: block;
    }
    .vecina {
      position: fixed;
      top: 50%;
      translate: 0 -50%;
      z-index: 5;
      display: grid;
      place-items: center;
      width: 3rem;
      height: 5rem;
      color: var(--suave);
      transition:
        color 0.25s ease,
        scale 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .vecina:hover {
      color: var(--texto);
      scale: 1.15;
    }
    .vecina svg {
      width: 14px;
      height: 26px;
    }
    .anterior-obra {
      left: clamp(0.5rem, 1.5vw, 1.5rem);
    }
    .siguiente-obra {
      right: clamp(0.5rem, 1.5vw, 1.5rem);
    }
  }


  @media (max-width: 899px) {
    /* Sitio arriba para "Cerrar", que va en la esquina. */
    :global(main:has(.obra)) {
      padding-top: 3.5rem;
    }
    /* En el móvil la página tiene scroll, así que la foto no se limita a lo
       alto de la pantalla: ocupa todo el ancho, con el mismo margen a los
       dos lados que "Cerrar" y "Siguiente". Antes, en un iPhone (con las
       barras de Safari la pantalla útil es más baja) salía más estrecha y
       quedaba un margen derecho mayor que el izquierdo. En tabletas, como
       mucho 34rem, con "Cerrar" y las flechas alineados con ella. */
    .columna-fotos {
      width: min(100%, 34rem);
    }
    .carrusel {
      width: 100%;
    }
  }

  /* Título de la obra algo más pequeño que el de las páginas de sección
     (pedido de Guzmán): 32 px en ordenador y 23 en móvil, antes 38,4 y 25,6. */
  .ficha h1 {
    margin: 0 0 0.75rem;
    font-size: calc(2em * var(--serif-escala));
  }

  @media (max-width: 899px) {
    .ficha h1 {
      font-size: calc(1.44em * var(--serif-escala));
    }
  }

  .datos {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    color: var(--suave);
  }

  .texto {
    margin: 0 0 1.25rem;
  }

  .ficha :global(.estado-ficha) {
    display: flex;
    width: fit-content;
    margin: 0 0 1.25rem;
    font-weight: 300;
  }

  /* En ordenador (pedido de Guzmán): el carrusel 3:4 centrado en la
     pantalla, en la columna del medio de tres iguales a los lados; la ficha
     en la columna de la derecha, separada de la foto, y empezando algo por
     debajo del borde de arriba de la foto (un 18 % de su alto; antes 12 %, Guzmán la quiso algo más abajo). */
  @media (min-width: 900px) {
    /* Sin scroll: la página mide justo la pantalla y la foto va centrada en
       vertical, con el mismo margen arriba que abajo (--hueco-v). "Cerrar"
       cuelga encima de la foto, dentro del margen de arriba. */
    :global(body:has(.obra)) {
      height: 100svh;
      overflow: hidden;
    }
    :global(main:has(.obra)) {
      padding-block: 0;
    }
    .obra {
      --hueco-v: clamp(2.5rem, 7svh, 4.5rem);
      --alto: calc(100svh - 2 * var(--hueco-v));
      height: 100svh;
      /* Columna de las fotos con el ancho exacto del 3:4 (como mucho el
         50 %); si fuera "auto", se estiraba con la fila de fotos. */
      grid-template-columns: minmax(0, 1fr) min(calc(var(--alto) * 0.75), 50%) minmax(0, 1fr);
      gap: 0;
      align-items: center;
    }
    .columna-fotos {
      grid-column: 2;
      position: relative;
    }
    .puntos {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
    }
    .ficha {
      grid-column: 3;
      align-self: start;
