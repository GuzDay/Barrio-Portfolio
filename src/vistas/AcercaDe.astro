---
// Acerca de mí y contacto, en la misma página (decisión de Guzmán). "Contacto"
// en el menú lleva directamente al bloque de abajo.
import Base from '../layouts/Base.astro';
import { ambas, urlAcercaDe, type Idioma } from '../lib/rutas';
import { sitio, urlInstagram, urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base idioma={idioma} alternativas={ambas(urlAcercaDe)} titulo={t.acercaDe} descripcion={t.biografia[0]} activa="acerca">
  <h1>{t.acercaDe}</h1>
  <div class="texto-largo">
    {t.biografia.map((parrafo) => <p>{parrafo}</p>)}
  </div>

  <section id="contacto" class="contacto">
    <h2>{t.contacto}</h2>
    <p>{t.contactoIntro}</p>
    <p><a class="boton" href={urlWhatsApp(t.mensajeContacto)}>{t.escribirWhatsApp}</a></p>
    <dl>
      <div><dt>{t.telefono}</dt><dd><a href={`tel:+${sitio.whatsapp}`}>{sitio.telefonoVisible}</a></dd></div>
      <div><dt>{t.correo}</dt><dd><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></dd></div>
      <div><dt>{t.instagram}</dt><dd><a href={urlInstagram}>@{sitio.instagram}</a></dd></div>
    </dl>
  </section>
</Base>

<style>
  .contacto {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--linea);
    scroll-margin-top: 1rem;
  }

  h2 {
    margin: 0 0 1rem;
  }

  dl {
    margin: 2rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  dl div {
    display: flex;
    gap: 1rem;
  }

  dt {
    min-width: 6rem;
    color: var(--suave);
  }

  dd {
    margin: 0;
  }
</style>
