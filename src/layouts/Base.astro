---
// Marco común de todas las páginas: <head>, cabecera, contenido y pie.
// Las dos tipografías (Google Fonts, licencia libre OFL), guardadas dentro
// de la web: no dependen de ningún servicio externo. Ver global.css.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/inter-tight/wght.css';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { conBase, type Idioma } from '../lib/rutas';
import { sitio, SIN_INDEXAR } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  alternativas: Record<Idioma, string>; // la misma página en cada idioma
  titulo?: string;
  descripcion?: string;
  activa?: string; // qué entrada del menú se marca
  portada?: boolean; // la portada: cabecera sobre la foto y pie en blanco
  sinCabecera?: boolean; // la página de cada obra va sin cabecera ni pie (pedido de Guzmán)
}

const { idioma, alternativas, titulo, descripcion, activa, portada, sinCabecera } = Astro.props;
const t = textos[idioma];
const tituloCompleto = titulo ? `${titulo} — ${sitio.nombre}` : `${sitio.nombre} — ${t.profesion}`;
const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Si el navegador de quien entra no está en español, se le lleva a la
        versión inglesa de ESTA misma página. Va lo primero para que no llegue
        a verse un parpadeo en español. Solo ocurre la primera vez: en cuanto
        alguien toca ES o EN en la cabecera, manda su elección. Nunca lleva de
        inglés a español, así que no puede entrar en bucle. (Copiado de la web
        de Blanca, donde se probó con es-ES, es-MX, en-US, en-GB, fr-FR y pt-BR.) */}
    {idioma === 'es' && (
      <script is:inline define:vars={{ enIngles: alternativas.en }}>
        (function () {
          try {
            if (localStorage.getItem('idioma')) return; // ya eligió
          } catch (e) {
            /* sin almacenamiento se sigue, pero solo una vez por pestaña */
          }
          try {
            if (sessionStorage.getItem('idioma-mirado')) return;
            sessionStorage.setItem('idioma-mirado', '1');
          } catch (e) {
            /* sin sessionStorage se mira igual: la redirección va siempre en
               el mismo sentido y no puede repetirse en bucle */
          }
          var lenguas = navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language || ''];
          var entiendeEspanol = lenguas.some(function (l) {
            return String(l).toLowerCase().indexOf('es') === 0;
          });
          if (!entiendeEspanol) location.replace(enIngles);
        })();
      </script>
    )}
    <title>{tituloCompleto}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="canonical" href={absoluta(alternativas[idioma])} />
    <link rel="alternate" hreflang="es" href={absoluta(alternativas.es)} />
    <link rel="alternate" hreflang="en" href={absoluta(alternativas.en)} />
    <link rel="alternate" hreflang="x-default" href={absoluta(alternativas.es)} />
    {SIN_INDEXAR && <meta name="robots" content="noindex" />}
    {/* El icono de la pestaña: la "B" de la firma de Pablo (recortada de su
        firma real, sin redibujar), en blanco sobre un cuadrado negro. El .ico
        para navegadores viejos y el PNG para el acceso directo del móvil. */}
    <link rel="icon" href={conBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={conBase('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={conBase('/apple-touch-icon.png')} />
    {/* La vista previa al compartir un enlace (WhatsApp, Telegram, redes):
        título, frase e imagen. La imagen la hizo Guzmán (1200x630, el
        tamaño que piden todas); el original está en
        00 Barrio/Web/Fotos de la web/Imagen para compartir (1200x630).jpg.
        Para cambiarla, sustituir public/compartir.jpg. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:locale" content={idioma === 'en' ? 'en_GB' : 'es_ES'} />
    <meta property="og:url" content={absoluta(alternativas[idioma])} />
    {/* En la portada, solo su nombre (pedido de Guzmán); en las demás, "Página — nombre". */}
    <meta property="og:title" content={titulo ? tituloCompleto : sitio.nombre} />
    {/* Sin frase propia, ninguna: mejor solo el título que repetirlo. */}
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta property="og:image" content={absoluta(conBase('/compartir.jpg'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${sitio.nombre} — ${t.profesion}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.saltar}</a>
    {!sinCabecera && <Cabecera idioma={idioma} alternativas={alternativas} activa={activa} portada={portada} />}
    <main id="contenido">
      <slot />
    </main>
    {!sinCabecera && <Pie blanco={portada} />}
  </body>
</html>
