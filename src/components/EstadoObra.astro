---
// Si una obra está disponible o vendida. Ocupa el lugar del precio, que no se
// enseña en la web (decisión de Guzmán, 16-10-2026).
import type { Idioma } from '../lib/rutas';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  vendida: boolean;
  class?: string;
}

const { idioma, vendida, class: clase } = Astro.props;
const t = textos[idioma];
---

<p class:list={['estado', clase, { vendida }]}>{vendida ? t.vendida : t.disponible}</p>

<style>
  .estado {
    margin: 0;
  }
</style>
