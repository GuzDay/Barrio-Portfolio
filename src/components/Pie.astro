---
// Pie de página: solo el copyright, centrado (pedido de Guzmán, 16-10-2026;
// el contacto ya está en la página de Contacto). En la portada va en blanco,
// sobre la foto.
import { sitio } from '../lib/sitio';

interface Props {
  blanco?: boolean;
}

const { blanco } = Astro.props;
---

<footer class:list={['pie', { blanco }]}>
  <p>© {new Date().getFullYear()} {sitio.nombre}</p>
</footer>

<style>
  .pie {
    padding: 2rem var(--lateral);
    text-align: center;
    font-size: calc(0.85em * var(--serif-escala));
    color: var(--suave);
  }

  /* En la portada, aparece con un fundido al final de la apertura. */
  .pie.blanco {
    color: #fff;
    animation: pie-aparece 0.8s ease 0.9s backwards;
  }

  @keyframes pie-aparece {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pie.blanco {
      animation: none;
    }
  }

  /* Al 70 % de opacidad, en todas las páginas (pedido de Guzmán). */
  p {
    margin: 0;
    opacity: 0.7;
  }

  /* En el móvil, la barra del navegador se dibuja encima de lo último de la
     página: se le deja hueco (aprendido en la web de Blanca). */
  @media (max-width: 700px) {
    .pie {
      padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
