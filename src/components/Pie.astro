---
// Pie de página: contacto directo, en todas las páginas.
import type { Idioma } from '../lib/rutas';
import { sitio, urlInstagram, urlWhatsApp } from '../lib/sitio';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
}

const t = textos[Astro.props.idioma];
---

<footer class="pie">
  <p>© {new Date().getFullYear()} {sitio.nombre}</p>
  <ul>
    <li><a href={urlWhatsApp(t.mensajeContacto)}>WhatsApp</a></li>
    <li><a href={urlInstagram}>{t.instagram}</a></li>
    <li><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
  </ul>
</footer>

<style>
  .pie {
    padding: 2rem var(--lateral);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: calc(0.85em * var(--serif-escala));
    color: var(--suave);
  }

  p,
  ul {
    margin: 0;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--texto);
  }

  /* En el móvil, la barra del navegador se dibuja encima de lo último de la
     página: se le deja hueco (aprendido en la web de Blanca). */
  @media (max-width: 700px) {
    .pie {
      padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
