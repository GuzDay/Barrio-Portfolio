---
// Fondo de la portada: una foto a pantalla completa en blanco y negro que se
// va "pintando" con su color real al pasar el ratón por encima, como si el
// ratón fuera un pincel. Lo pintado se queda.
//
// En el móvil se pinta arrastrando el dedo (la portada ocupa una sola
// pantalla, así que no hay scroll al que estorbar). Como ahí nadie sabría que
// se puede, al entrar la foto se pinta sola una pincelada a modo de invitación.
//
// Cómo funciona: debajo, la foto en gris (CSS). Encima, un <canvas> donde se
// dibuja la foto en color, pero solo donde ha pasado el pincel. Lo pintado se
// guarda en una máscara medida sobre la foto (no sobre la pantalla), así que
// al cambiar el tamaño de la ventana no se descoloca.
import { Image, getImage } from 'astro:assets';

interface Props {
  foto: ImageMetadata;
  // Otra foto para pantallas en vertical (el móvil), donde la horizontal se
  // recortaba mucho por los lados. El navegador baja solo la que le toca.
  fotoVertical?: ImageMetadata;
}

const { foto, fotoVertical } = Astro.props;
const anchos = (f: ImageMetadata) => [600, 900, 1200, 1600, 2400, 3200].filter((w) => w <= f.width);
const vertical = fotoVertical
  ? (await Promise.all(anchos(fotoVertical).map((w) => getImage({ src: fotoVertical, width: w, format: 'webp' }))))
      .map((r, i) => `${r.src} ${anchos(fotoVertical)[i]}w`)
      .join(', ')
  : undefined;
---

<div class="lienzo" aria-hidden="true">
  <picture>
    {vertical && <source media="(orientation: portrait)" srcset={vertical} sizes="100vw" type="image/webp" />}
    <Image
      src={foto}
      alt=""
      widths={[800, 1200, 1600, 2400, 3200].filter((w) => w <= foto.width)}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <canvas></canvas>
  <div class="velo"></div>
</div>
<script is:inline>
  // La foto entra con un poco de zoom (ver "acercar" abajo): hasta que esté
  // lista para verse, espera ya ampliada, para que no dé un salto. Red de
  // seguridad: si algo falla, a los 4 s se queda normal.
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var capa = document.currentScript.previousElementSibling;
    capa.classList.add('por-acercar');
    setTimeout(function () {
      capa.classList.remove('por-acercar');
    }, 4000);
  })();
</script>
<script is:inline>
  // La portada no reserva el hueco de la barra de desplazamiento (ver
  // global.css): nunca la tiene, y el hueco quedaría como una franja vacía al
  // lado de la foto. Para que la cabecera y el pie queden igual que en las
  // demás páginas, se mide el hueco que reservan ellas (0 en los Mac con
  // barras que solo aparecen al desplazar) y se les deja ese margen.
  // Se mide en la propia página, reservándolo un instante: antes se medía
  // con una caja de prueba con barra propia, y el navegador puede dibujar
  // distinta la barra de una caja y la de la página (en Chrome salía 0
  // frente a 15 px, y el menú saltaba al pasar de una sección a la portada).
  (function () {
    var html = document.documentElement;
    html.style.scrollbarGutter = 'stable';
    var hueco = innerWidth - html.getBoundingClientRect().width;
    html.style.scrollbarGutter = '';
    html.style.setProperty('--barra', Math.max(0, hueco) + 'px');
  })();
</script>

<script>
  const capa = document.querySelector<HTMLElement>('.lienzo')!;
  const gris = capa.querySelector('img')!;
  const lienzo = capa.querySelector('canvas')!;
  const ctx = lienzo.getContext('2d')!;

  // Con ratón se pinta al pasar por encima; en pantallas táctiles, con el dedo.
  const conRaton = matchMedia('(hover: hover) and (pointer: fine)').matches;

  let color: HTMLImageElement | null = null; // la foto en color, ya cargada
  const mascara = document.createElement('canvas'); // dónde se ha pintado, medido sobre la foto
  const mctx = mascara.getContext('2d')!;
  let escala = 1; // píxeles de pantalla por píxel de la máscara
  let dx = 0;
  let dy = 0; // dónde empieza la foto en pantalla (recorte tipo "cover")
  let pendiente = false;
  let ultimo: { x: number; y: number } | null = null;

  // La misma cuenta que hace object-fit: cover con la foto en gris, para que
  // el color caiga exactamente encima.
  function medir() {
    const ppp = Math.min(devicePixelRatio || 1, 2);
    // El tamaño de la capa (no el de la ventana): en el móvil la capa es más
    // alta que el hueco visible, para llegar debajo de las barras de Safari.
    const caja = capa.getBoundingClientRect();
    const w = caja.width;
    const h = caja.height;
    lienzo.width = Math.round(w * ppp);
    lienzo.height = Math.round(h * ppp);
    ctx.setTransform(ppp, 0, 0, ppp, 0, 0);
    escala = Math.max(w / mascara.width, h / mascara.height);
    dx = (w - mascara.width * escala) / 2;
    dy = (h - mascara.height * escala) / 2;
    redibujar();
  }

  function redibujar() {
    if (pendiente || !color) return;
    pendiente = true;
    requestAnimationFrame(() => {
      pendiente = false;
      const w = mascara.width * escala;
      const h = mascara.height * escala;
      ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, lienzo.width, lienzo.height);
      ctx.drawImage(color!, dx, dy, w, h);
      ctx.globalCompositeOperation = 'destination-in';
      ctx.drawImage(mascara, dx, dy, w, h);
    });
  }

  // Una pincelada: un círculo duro, de borde nítido y color pleno
  // (pedido de Guzmán; antes eran manchas difuminadas).
  function pincelada(x: number, y: number) {
    // Radio: en ordenador crece con la pantalla (50 px a 1440 de ancho; un
    // poco más pequeño desde el 16-10-2026, antes 65); en el móvil, 30 px.
    const radio = (conRaton ? Math.min(Math.max(innerWidth * 0.035, 30), 64) : 30) / escala;
    mctx.fillStyle = '#000';
    mctx.beginPath();
    mctx.arc((x - dx) / escala, (y - dy) / escala, radio, 0, Math.PI * 2);
    mctx.fill();
  }

  // Con el dedo, la pintura sale un poco por encima de donde toca, para que
  // el propio dedo no tape lo que se está pintando.
  const ENCIMA_DEL_DEDO = 64; // px

  function pintar(e: PointerEvent) {
    const subir = e.pointerType === 'touch' ? ENCIMA_DEL_DEDO : 0;
    trazoHasta({ x: e.clientX, y: e.clientY - subir });
  }

  function trazoHasta(p: { x: number; y: number }) {
    if (!color) return;
    // Rellenar el hueco entre dos movimientos para que el trazo sea continuo.
    const paso = Math.max(innerWidth * 0.012, 8);
    if (ultimo) {
      const d = Math.hypot(p.x - ultimo.x, p.y - ultimo.y);
      const n = Math.min(Math.ceil(d / paso), 60);
      for (let i = 1; i <= n; i++) {
        pincelada(ultimo.x + ((p.x - ultimo.x) * i) / n, ultimo.y + ((p.y - ultimo.y) * i) / n);
      }
    } else {
      pincelada(p.x, p.y);
    }
    ultimo = p;
    redibujar();
  }

  function preparar() {
    // La foto en color es la misma que ya ha descargado el navegador para la
    // capa gris (currentSrc), así que no se descarga dos veces.
    const img = new Image();
    img.decoding = 'async';
    img.onload = () => {
      color = img;
      // La máscara a 2000 px como mucho: con el pincel duro, una máscara más
      // pequeña se estiraría y el borde del círculo saldría borroso.
      const red = Math.min(1, 2000 / Math.max(img.naturalWidth, img.naturalHeight));
      mascara.width = Math.round(img.naturalWidth * red);
      mascara.height = Math.round(img.naturalHeight * red);
      medir();
      if (!conRaton) setTimeout(invitacion, 500);
    };
    img.src = gris.currentSrc || gris.src;
  }

  // Móvil: una pincelada que cruza la figura sola, de izquierda a derecha y
  // ondulando, para enseñar que la foto se puede pintar. Si el dedo toca la
  // pantalla mientras tanto, se para y manda el dedo.
  let invitando = false;
  function invitacion() {
    invitando = true;
    ultimo = null;
    const dur = 1500;
    const t0 = performance.now();
    const paso = (ahora: number) => {
      if (!invitando) return;
      const t = Math.min((ahora - t0) / dur, 1);
      const e = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2; // suave al empezar y al acabar
      trazoHasta({
        x: innerWidth * (0.12 + 0.76 * e),
        y: innerHeight * (0.5 + 0.12 * Math.sin(e * Math.PI * 2.2)),
      });
      if (t < 1) requestAnimationFrame(paso);
      else (invitando = false), (ultimo = null);
    };
    requestAnimationFrame(paso);
  }

  // Al llegar, la foto aparece con un poco de zoom y vuelve despacio a su
  // tamaño (pedido de Guzmán: sutil y elegante). Siempre, se llegue como se
  // llegue. Empieza cuando la foto ya se puede pintar, y se aplica a la foto
  // y al lienzo de color a la vez (no a la capa, que se mide para pintar).
  if (capa.classList.contains('por-acercar')) {
    const cargada = gris.complete ? Promise.resolve() : new Promise((ok) => gris.addEventListener('load', ok, { once: true }));
    cargada
      .then(() => gris.decode().catch(() => {}))
      .then(() => {
        for (const pieza of [gris, lienzo]) {
          pieza.animate([{ transform: 'scale(1.06)' }, { transform: 'none' }], {
            duration: 2400,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          });
        }
        // A la vez, la foto sale de un velo blanco, el fondo de las demás
        // páginas: así no aparece de golpe y hay continuidad al llegar desde
        // ellas (pedido de Guzmán: que casi no se note). Más corto que el
        // zoom, para que este siga cuando la foto ya se ve entera.
        capa.querySelector('.velo')!.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 1100,
          easing: 'cubic-bezier(0.33, 0, 0.25, 1)',
        });
        capa.classList.remove('por-acercar');
      });
  }

  if (gris.complete && gris.naturalWidth) preparar();
  // También cada vez que cambia la foto (al girar el móvil se pasa de la
  // vertical a la horizontal): la versión en color tiene que ser la misma.
  gris.addEventListener('load', preparar);
  addEventListener('resize', medir);

  if (conRaton) {
    addEventListener('pointermove', pintar, { passive: true });
    // Al salir de la ventana se levanta el pincel: al volver no se une el trazo.
    document.addEventListener('pointerleave', () => (ultimo = null));
    addEventListener('blur', () => (ultimo = null));
  } else {
    // Que arrastrar el dedo pinte en vez de mover o seleccionar (se deja
    // pellizcar para ampliar). Solo en esta página.
    document.documentElement.classList.add('pintando-con-dedo');
    addEventListener('pointerdown', (e) => {
      invitando = false;
      ultimo = null;
      pintar(e);
    });
    addEventListener('pointermove', (e) => e.buttons && pintar(e), { passive: true });
    for (const fin of ['pointerup', 'pointercancel']) addEventListener(fin, () => (ultimo = null));
  }
</script>

<style is:global>
  html.pintando-con-dedo {
    touch-action: pinch-zoom;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
</style>

<style>
  /* Alto "grande" de pantalla (100lvh): el que hay con las barras de Safari
     escondidas, para que en el móvil la foto llegue hasta los bordes del
     teléfono y no se quede en el hueco entre las barras. */
  .lienzo {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    overflow: hidden;
    background: var(--fondo);
  }

  img,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  img {
    object-fit: cover;
    filter: grayscale(1);
  }

  .lienzo.por-acercar img,
  .lienzo.por-acercar canvas {
    transform: scale(1.06);
  }

  /* Velo blanco por encima de todo lo de la capa (también del degradado de
     abajo): tapa la foto mientras se prepara y luego se desvanece. */
  .velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .lienzo.por-acercar .velo {
    opacity: 1;
  }

  /* Degradado sutil abajo, para que el copyright (en blanco) se lea sobre
     cualquier foto. Va encima del color pintado y no estorba al ratón. */
  .lienzo::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: min(30vh, 220px);
    background: linear-gradient(to top, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0));
    pointer-events: none;
  }
</style>
