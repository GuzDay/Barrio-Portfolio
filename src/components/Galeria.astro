---
// Rejilla de obras de una sección (Pintura y Escultura usan esta misma). Todas
// las tarjetas miden lo mismo: la foto se recorta a 3:4 vertical (la obra
// entera se ve en su propia página). El filtro "Disponibles" esconde las
// vendidas sin recargar la página.
//
// Las fotos salen en blanco y negro y se colorean:
//  - con ratón, al pasar por encima de la tarjeta, que además gana relieve;
//  - en pantallas táctiles (sin "pasar por encima"), con el scroll: solo las
//    dos más centradas en pantalla en cada momento; el resto, en gris.
//
// Al llegar a la sección, las tarjetas entran volando desde la izquierda
// como si alguien las lanzara, y al irse salen disparadas por la derecha
// (pedido de Guzmán, 16-10-2026).
import { Image } from 'astro:assets';
import { marco34 } from '../lib/fotos';
import { ficha, type Obra } from '../lib/obras';
import { urlObra, type Idioma, type Seccion } from '../lib/rutas';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  seccion: Seccion;
  obras: Obra[];
}

const { idioma, seccion, obras } = Astro.props;
const t = textos[idioma];
const hayVendidas = obras.some((o) => o.data.estado === 'vendido');
// Hubo un tercer botón, "Año", que ordenaba por año; se quitó al dejar de
// enseñarse el año (pedido de Pablo, 30-10-2026).
---

{hayVendidas && (
  <div class="filtro" role="group" aria-label={t.filtrar}>
    <button type="button" data-filtro="todas" aria-pressed="true">{t.todas}</button>
    <button type="button" data-filtro="disponibles" aria-pressed="false">{t.disponibles}</button>
  </div>
)}

<ul class="galeria" data-mostrando="todas">
  {obras.map((obra, i) => {
    const f = ficha(obra, idioma);
    return (
      <li data-vendida={f.vendida ? '' : undefined}>
        <a class="tarjeta" href={urlObra(seccion, obra.id, idioma)}>
          <div class="foto">
            <Image
              src={f.fotos[0]}
              alt={f.titulo}
              {...marco34(f.fotos[0], [240, 360, 540, 720])}
              sizes="(min-width: 1760px) 350px, (min-width: 1000px) 20vw, 46vw"
              loading={i < 4 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="pie-tarjeta">
            {/* Solo el nombre y las medidas (pedido de Guzmán); lo demás, en la
                página de la obra. */}
            <p class="titulo">{f.titulo}</p>
            {f.medidas && <p class="datos" title={f.medidas}>{f.medidas}</p>}
          </div>
        </a>
      </li>
    );
  })}
</ul>
<script is:inline>
  // Antes de pintar: las tarjetas empiezan escondidas para que entren
  // volando (ver "llegar" abajo) en vez de verse un instante en su sitio.
  // Red de seguridad: si algo falla, aparecen solas a los 4 s.
  // Si se vuelve de una de sus obras, no hay lanzamiento: la foto vuelve
  // volando a su tarjeta (transición entre páginas, ver más abajo).
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var g = document.currentScript.previousElementSibling;
    try {
      var r = new URL(document.referrer);
      if (r.origin === location.origin && r.pathname !== location.pathname && r.pathname.indexOf(location.pathname) === 0) return;
    } catch (e) {}
    g.classList.add('por-llegar');
    setTimeout(function () {
      g.classList.remove('por-llegar');
    }, 4000);
  })();
</script>
<p class="vacia" hidden>{t.ningunaDisponible}</p>

<script>
  const galeria = document.querySelector<HTMLElement>('.galeria');
  const vacia = document.querySelector<HTMLElement>('.vacia');
  const botones = document.querySelectorAll<HTMLButtonElement>('.filtro button');
  for (const boton of botones) {
    boton.addEventListener('click', () => {
      for (const b of botones) b.setAttribute('aria-pressed', String(b === boton));
      const filtro = boton.dataset.filtro!;
      galeria!.dataset.mostrando = filtro;
      const quedan = galeria!.querySelectorAll('li:not([data-vendida])').length;
      vacia!.hidden = !(filtro === 'disponibles' && quedan === 0);
    });
  }

  // Pantallas táctiles: como mucho DOS tarjetas en color a la vez, las dos
  // más centradas en pantalla (con dos columnas, suelen ser las de la fila
  // del medio). Se recalcula al hacer scroll. Con ratón no hace falta: lo
  // hace el CSS al pasar por encima.
  // ---------- Llegada y salida ----------
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const azar = (a: number, b: number) => a + Math.random() * (b - a);
  const tarjetasLi = () => [...(galeria?.querySelectorAll<HTMLElement>('li') ?? [])];
  const letras = () => [...document.querySelectorAll<HTMLElement>('.titulo-seccion .letra')];
  const filtros = () => [...document.querySelectorAll<HTMLElement>('.filtro button')];

  // Llegada: cada tarjeta entra desde fuera de la pantalla por la izquierda,
  // un poco girada, como lanzada, y frena de forma larga y progresiva (llega
  // rápida y va perdiendo velocidad muy poco a poco) hasta asentarse con un
  // vaivén apenas perceptible. Aparece fundiéndose. Una tras otra.
  function llegar() {
    if (!galeria || sinMovimiento) return;
    // El título de la sección, a la vez: cada letra sube un poco desde abajo,
    // pasando de desenfocada a nítida, una tras otra (pedido de Guzmán: algo
    // sutil y elegante).
    letras().forEach((letra, i) => {
      letra.getAnimations().forEach((a) => a.cancel());
      letra.animate(
        [
          { transform: 'translateY(0.45em)', opacity: 0, filter: 'blur(6px)' },
          { transform: 'none', opacity: 1, filter: 'blur(0)' },
        ],
        { duration: 1100, delay: 80 + i * 45, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' },
      );
    });
    // "Todas" y "Disponibles", algo más sencillo y justo después: cada uno
    // aparece subiendo apenas, sin desenfoque.
    filtros().forEach((boton, i) => {
      boton.getAnimations().forEach((a) => a.cancel());
      boton.animate(
        [
          { transform: 'translateY(0.4em)', opacity: 0 },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 800, delay: 380 + i * 90, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' },
      );
    });
    tarjetasLi().forEach((li, i) => {
      li.getAnimations().forEach((a) => a.cancel());
      li.animate(
        [
          { transform: `translate(-100vw, ${azar(-24, 16)}px) rotate(${azar(-8, -4)}deg)`, opacity: 0, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          { opacity: 1, offset: 0.35, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          { transform: `translate(5px, 0) rotate(${azar(0.4, 0.9)}deg)`, offset: 0.82, easing: 'cubic-bezier(0.37, 0, 0.63, 1)' },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 1400, delay: Math.min(i, 12) * 90, fill: 'backwards' },
      );
    });
    galeria.classList.remove('por-llegar');
  }

  // Salida: las tarjetas a la vista salen disparadas por la derecha,
  // acelerando, empezando por las de la derecha. Devuelve cuánto tarda, para
  // que el cambio de página espere a que se hayan ido.
  function salir(): number {
    if (!galeria || sinMovimiento) return 0;
    const visibles: { li: HTMLElement; r: DOMRect }[] = [];
    const resto: HTMLElement[] = [];
    for (const li of tarjetasLi()) {
      const r = li.getBoundingClientRect();
      if (r.height && r.bottom > 0 && r.top < innerHeight) visibles.push({ li, r });
      else resto.push(li);
    }
    visibles.sort((a, b) => b.r.left - a.r.left || a.r.top - b.r.top);
    // Arranca despacio y acelera de forma progresiva, sin tirón; poco giro y
    // se desvanece al final.
    const DURACION = 620;
    const PASO = 40;
    const animar = (li: HTMLElement, delay: number) =>
      li.animate(
        [
          { transform: 'none', opacity: 1 },
          { opacity: 1, offset: 0.55 },
          { transform: `translate(100vw, ${azar(-16, 12)}px) rotate(${azar(4, 8)}deg)`, opacity: 0 },
        ],
        { duration: DURACION, delay, easing: 'cubic-bezier(0.55, 0.05, 0.68, 0.19)', fill: 'forwards' },
      );
    // El título se va al revés que llegó: cada letra sube y se desvanece
    // desenfocándose, una tras otra.
    letras().forEach((letra, i) =>
      letra.animate(
        [
          { transform: 'none', opacity: 1, filter: 'blur(0)' },
          { transform: 'translateY(-0.3em)', opacity: 0, filter: 'blur(4px)' },
        ],
        { duration: 420, delay: i * 30, easing: 'cubic-bezier(0.55, 0, 0.75, 0.2)', fill: 'forwards' },
      ),
    );
    // "Todas" y "Disponibles" se desvanecen subiendo apenas, a la vez.
    filtros().forEach((boton) =>
      boton.animate(
        [
          { transform: 'none', opacity: 1 },
          { transform: 'translateY(-0.25em)', opacity: 0 },
        ],
        { duration: 320, easing: 'cubic-bezier(0.55, 0, 0.75, 0.2)', fill: 'forwards' },
      ),
    );
    visibles.forEach(({ li }, i) => animar(li, i * PASO));
    resto.forEach((li) => animar(li, 0));
    // Se cambia de página cuando la última ya casi ha desaparecido.
    // (y el título también).
    const tarjetas = (DURACION + Math.max(visibles.length - 1, 0) * PASO) * 0.9;
    const titulo = (420 + Math.max(letras().length - 1, 0) * 30) * 0.9;
    return Math.round(Math.max(tarjetas, titulo));
  }

  // ---------- Transición a la página de una obra ----------
  // Al pulsar una tarjeta, su foto "vuela" hasta donde queda en la página de
  // la obra y el resto se funde (pedido de Guzmán); al volver, al revés.
  // Usa las transiciones entre páginas del navegador (Chrome 126+, Safari
  // 18.2+); en los demás, se cambia de página sin más. La foto que vuela se
  // marca con el nombre "foto-obra" justo en el momento del cambio.
  const deEstaSeccion = (url: string) => {
    try {
      const u = new URL(url, location.href);
      return u.origin === location.origin && u.pathname !== location.pathname && u.pathname.startsWith(location.pathname);
    } catch {
      return false;
    }
  };
  const marcar = (url: string) => {
    const a = [...(galeria?.querySelectorAll<HTMLAnchorElement>('.tarjeta') ?? [])].find(
      (t) => new URL(t.href).pathname === new URL(url, location.href).pathname,
    );
    const img = a?.querySelector<HTMLElement>('img');
    if (img) img.style.viewTransitionName = 'foto-obra';
    return img;
  };
  addEventListener('pageswap', (e: any) => {
    if (!e.viewTransition) return;
    const destino = e.activation?.entry?.url ?? '';
    if (!deEstaSeccion(destino)) return e.viewTransition.skipTransition();
    marcar(destino);
  });
  addEventListener('pagereveal', (e: any) => {
    if (!e.viewTransition) return;
    const desde = (globalThis as any).navigation?.activation?.from?.url ?? document.referrer;
    if (!deEstaSeccion(desde)) return e.viewTransition.skipTransition();
    const img = marcar(desde);
    e.viewTransition.finished.finally(() => img && (img.style.viewTransitionName = ''));
  });

  // ---------- Volver a la misma altura ----------
  // "Cerrar" (en la página de la obra) es un enlace normal, así que la galería se
  // abría arriba del todo. Al pulsar una tarjeta se apunta por dónde iba el
  // scroll (y el filtro, que cambia la altura); al volver de esa obra se
  // deja igual antes de pintar, para que la foto vuele a su tarjeta.
  const CLAVE = 'galeria:' + location.pathname;
  galeria?.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('a.tarjeta')) return;
    try {
      sessionStorage.setItem(CLAVE, JSON.stringify({ y: scrollY, filtro: galeria.dataset.mostrando ?? '' }));
    } catch {}
  });
  const volviendo = deEstaSeccion((globalThis as any).navigation?.activation?.from?.url ?? document.referrer);
  if (galeria && volviendo) {
    try {
      const antes = JSON.parse(sessionStorage.getItem(CLAVE) ?? 'null');
      if (antes) {
        if (antes.filtro && antes.filtro !== galeria.dataset.mostrando)
          [...botones].find((b) => b.dataset.filtro === antes.filtro)?.click();
        scrollTo(0, antes.y);
      }
    } catch {}
    // Si desde la obra se pasó a otra con "Anterior / Siguiente", la que se
    // cierra puede no estar a la vista: se centra su tarjeta, para que la
    // foto vuele a un sitio visible.
    const desde = (globalThis as any).navigation?.activation?.from?.url ?? document.referrer;
    const tarjeta = [...galeria.querySelectorAll<HTMLAnchorElement>('.tarjeta')].find(
      (t) => new URL(t.href).pathname === new URL(desde).pathname,
    );
    const r = tarjeta?.getBoundingClientRect();
    if (r && r.height && (r.top < 0 || r.bottom > innerHeight)) tarjeta!.scrollIntoView({ block: 'center' });
  }

  if (galeria) {
    if (!volviendo || sinMovimiento) llegar();
    else galeria.classList.remove('por-llegar');
    // La cabecera la usa al pulsar una sección (coordina su latido con esto).
    (window as unknown as { __salida?: () => number }).__salida = salir;
    // Cualquier otro enlace que saque de la sección (firma, idioma, menú del
    // móvil…). Los de las propias tarjetas no: abrir una obra no es irse.
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented) return;
      const a = (e.target as Element).closest('a');
      if (!a || a.closest('.galeria')) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target === '_blank') return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin || (url.pathname === location.pathname && url.hash)) return;
      const ms = salir();
      if (!ms) return;
      e.preventDefault();
      setTimeout(() => (location.href = a.href), ms);
    });
    // Al volver con el botón "atrás", el navegador puede enseñar la página tal
    // como quedó (con las tarjetas fuera): se las hace llegar de nuevo.
    addEventListener('pageshow', (e) => e.persisted && llegar());
  }

  // ---------- Color en pantallas táctiles ----------
  const COMO_MUCHO = 2;
  if (galeria && !matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let pendiente = false;
    const colorear = () => {
      pendiente = false;
      const centro = innerHeight / 2;
      const candidatas = [];
      for (const t of galeria.querySelectorAll<HTMLElement>('li:not([hidden]) .tarjeta')) {
        const r = t.getBoundingClientRect();
        if (!r.height) continue; // escondida por el filtro "Disponibles"
        // Cuánto de la tarjeta se ve: las que apenas asoman no cuentan.
        const visible = (Math.min(r.bottom, innerHeight) - Math.max(r.top, 0)) / r.height;
        if (visible < 0.4) continue;
        candidatas.push({ t, distancia: Math.abs((r.top + r.bottom) / 2 - centro) + r.left / 1000 });
      }
      const elegidas = new Set(candidatas.sort((a, b) => a.distancia - b.distancia).slice(0, COMO_MUCHO).map((c) => c.t));
      for (const t of galeria.querySelectorAll('.tarjeta')) t.classList.toggle('en-color', elegidas.has(t));
    };
    const pedir = () => {
      if (!pendiente) (pendiente = true), requestAnimationFrame(colorear);
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    for (const b of botones) b.addEventListener('click', pedir);
    pedir();
  }
</script>

<style>
  .filtro {
    display: flex;
    gap: 1rem;
    margin: -0.5rem 0 1.5rem;
  }

  .filtro button {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: var(--suave);
    cursor: pointer;
  }

  .filtro button[aria-pressed='true'] {
    color: var(--texto);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Dos columnas en el móvil y la tableta, cuatro en ordenador (corte en
     1000 px, como en la web de Blanca). La separación es algo menor que la
     de Blanca para que las tarjetas ganen tamaño (pedido de Guzmán). */
  .galeria {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem clamp(0.4rem, 0.7vw, 0.75rem);
  }

  @media (min-width: 1000px) {
    .galeria {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem clamp(0.4rem, 0.7vw, 0.75rem);
    }
  }

  .galeria.por-llegar li {
    visibility: hidden;
  }

  /* "Todas" y "Disponibles" también esperan escondidos a entrar. */
  :global(main:has(.galeria.por-llegar)) .filtro button {
    opacity: 0;
  }

  .galeria[data-mostrando='disponibles'] li[data-vendida] {
    display: none;
  }

  /* La tarjeta: un bloque blanco con relieve (sombra).
     Ocupa todo el alto de la fila para que las de una fila midan lo mismo. */
  .tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    background: var(--fondo);
    border-radius: 3px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 4px 12px rgb(0 0 0 / 0.06);
    transition:
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .foto {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--vacio);
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.6s ease;
  }

  /* Con ratón: al pasar por encima, la foto toma color y la tarjeta se
     levanta un poco (más sombra y unos píxeles hacia arriba). */
  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover,
    .tarjeta:focus-visible {
      transform: translateY(-4px);
      box-shadow:
        0 4px 8px rgb(0 0 0 / 0.08),
        0 18px 36px rgb(0 0 0 / 0.14);
    }
    .tarjeta:hover img,
    .tarjeta:focus-visible img {
      filter: grayscale(0);
    }
  }

  /* Pantallas táctiles: el color llega con el scroll (ver el script). */
  .tarjeta.en-color img {
    filter: grayscale(0);
    transition-duration: 0.9s;
  }

  .pie-tarjeta {
    padding: 0.75rem 0.9rem 0.9rem;
  }

  p {
    margin: 0;
  }

  /* El título de la obra va en la serif, como el resto de títulos. */
  .titulo {
    font-family: var(--serif);
    font-size: calc(1em * var(--serif-escala));
    font-weight: 400;
  }

  /* Las medidas, en una sola línea: si no caben (dípticos, trípticos…),
     se cortan con puntos suspensivos. Enteras, en la página de la obra. */
  .datos {
    color: var(--suave);
    font-size: 0.9em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* En dos columnas de móvil la tarjeta es estrecha: letra y relleno menores. */
  @media (max-width: 699px) {
    .pie-tarjeta {
      padding: 0.55rem 0.6rem 0.65rem;
    }
    .titulo {
      font-size: calc(0.9em * var(--serif-escala));
    }
    .datos {
      font-size: 0.8em;
    }
  }

  /* Quien pide en su sistema menos movimiento: sin levantar la tarjeta. */
  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .foto img {
      transition: none;
    }
    .tarjeta:hover {
      transform: none;
    }
  }
</style>

<style is:global>
  /* Activa las transiciones entre esta página y la otra (galería ↔ obra).
     Hace falta en las dos; el resto de páginas no lo llevan. */
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>
