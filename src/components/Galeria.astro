---
// Rejilla de obras de una sección (Pintura y Escultura usan esta misma). Todas
// las tarjetas miden lo mismo: la foto se recorta a 4:5 vertical (la obra
// entera se ve en su propia página). El filtro "Disponibles" esconde las
// vendidas sin recargar la página.
//
// Las fotos salen en blanco y negro y se colorean:
//  - con ratón, al pasar por encima de la tarjeta, que además gana relieve;
//  - en pantallas táctiles (sin "pasar por encima"), con el scroll: solo las
//    dos más centradas en pantalla en cada momento; el resto, en gris.
//
// Al llegar a la sección, las tarjetas entran volando desde la izquierda
// como si alguien las lanzara, y al irse salen disparadas por la derecha
// (pedido de Guzmán, 16-10-2026).
import { Image } from 'astro:assets';
import EstadoObra from './EstadoObra.astro';
import { ficha, type Obra } from '../lib/obras';
import { urlObra, type Idioma, type Seccion } from '../lib/rutas';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  seccion: Seccion;
  obras: Obra[];
}

const { idioma, seccion, obras } = Astro.props;
const t = textos[idioma];
const hayVendidas = obras.some((o) => o.data.estado === 'vendido');
---

{hayVendidas && (
  <div class="filtro" role="group" aria-label={t.filtrar}>
    <button type="button" data-filtro="todas" aria-pressed="true">{t.todas}</button>
    <button type="button" data-filtro="disponibles" aria-pressed="false">{t.disponibles}</button>
  </div>
)}

<ul class="galeria" data-mostrando="todas">
  {obras.map((obra, i) => {
    const f = ficha(obra, idioma);
    return (
      <li data-vendida={f.vendida ? '' : undefined}>
        <a class="tarjeta" href={urlObra(seccion, obra.id, idioma)}>
          <div class="foto">
            <Image
              src={f.fotos[0]}
              alt={f.titulo}
              widths={[240, 360, 540, 720]}
              sizes="(min-width: 1760px) 350px, (min-width: 1000px) 20vw, 46vw"
              loading={i < 4 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="pie-tarjeta">
            <p class="titulo">{f.titulo}{f.anio && <span>, {f.anio}</span>}</p>
            <p class="datos">{[f.tecnica, f.medidas].filter(Boolean).join(' · ')}</p>
            <EstadoObra idioma={idioma} vendida={f.vendida} class="estado-tarjeta" />
          </div>
        </a>
      </li>
    );
  })}
</ul>
<script is:inline>
  // Antes de pintar: las tarjetas empiezan escondidas para que entren
  // volando (ver "llegar" abajo) en vez de verse un instante en su sitio.
  // Red de seguridad: si algo falla, aparecen solas a los 4 s.
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var g = document.currentScript.previousElementSibling;
    g.classList.add('por-llegar');
    setTimeout(function () {
      g.classList.remove('por-llegar');
    }, 4000);
  })();
</script>
<p class="vacia" hidden>{t.ningunaDisponible}</p>

<script>
  const galeria = document.querySelector<HTMLElement>('.galeria');
  const vacia = document.querySelector<HTMLElement>('.vacia');
  const botones = document.querySelectorAll<HTMLButtonElement>('.filtro button');
  for (const boton of botones) {
    boton.addEventListener('click', () => {
      for (const b of botones) b.setAttribute('aria-pressed', String(b === boton));
      const filtro = boton.dataset.filtro!;
      galeria!.dataset.mostrando = filtro;
      const quedan = galeria!.querySelectorAll('li:not([data-vendida])').length;
      vacia!.hidden = !(filtro === 'disponibles' && quedan === 0);
    });
  }

  // Pantallas táctiles: como mucho DOS tarjetas en color a la vez, las dos
  // más centradas en pantalla (con dos columnas, suelen ser las de la fila
  // del medio). Se recalcula al hacer scroll. Con ratón no hace falta: lo
  // hace el CSS al pasar por encima.
  // ---------- Llegada y salida ----------
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const azar = (a: number, b: number) => a + Math.random() * (b - a);
  const tarjetasLi = () => [...(galeria?.querySelectorAll<HTMLElement>('li') ?? [])];

  // Llegada: cada tarjeta entra desde fuera de la pantalla por la izquierda,
  // un poco girada, como lanzada, y frena de forma larga y progresiva (llega
  // rápida y va perdiendo velocidad muy poco a poco) hasta asentarse con un
  // vaivén apenas perceptible. Viaja medio transparente y solo se vuelve del
  // todo opaca al llegar a su sitio. Una tras otra.
  function llegar() {
    if (!galeria || sinMovimiento) return;
    tarjetasLi().forEach((li, i) => {
      li.getAnimations().forEach((a) => a.cancel());
      li.animate(
        [
          { transform: `translate(-100vw, ${azar(-24, 16)}px) rotate(${azar(-8, -4)}deg)`, opacity: 0, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          { opacity: 0.3, offset: 0.25, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          { transform: `translate(5px, 0) rotate(${azar(0.4, 0.9)}deg)`, opacity: 1, offset: 0.82, easing: 'cubic-bezier(0.37, 0, 0.63, 1)' },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 1400, delay: Math.min(i, 12) * 90, fill: 'backwards' },
      );
    });
    galeria.classList.remove('por-llegar');
  }

  // Salida: las tarjetas a la vista salen disparadas por la derecha,
  // acelerando, empezando por las de la derecha. Devuelve cuánto tarda, para
  // que el cambio de página espere a que se hayan ido.
  function salir(): number {
    if (!galeria || sinMovimiento) return 0;
    const visibles: { li: HTMLElement; r: DOMRect }[] = [];
    const resto: HTMLElement[] = [];
    for (const li of tarjetasLi()) {
      const r = li.getBoundingClientRect();
      if (r.height && r.bottom > 0 && r.top < innerHeight) visibles.push({ li, r });
      else resto.push(li);
    }
    visibles.sort((a, b) => b.r.left - a.r.left || a.r.top - b.r.top);
    // Arranca despacio y acelera de forma progresiva, sin tirón; poco giro y
    // se va desvaneciendo mientras sale.
    const DURACION = 620;
    const PASO = 40;
    const animar = (li: HTMLElement, delay: number) =>
      li.animate(
        [
          { transform: 'none', opacity: 1 },
          { opacity: 0.6, offset: 0.4 },
          { transform: `translate(100vw, ${azar(-16, 12)}px) rotate(${azar(4, 8)}deg)`, opacity: 0 },
        ],
        { duration: DURACION, delay, easing: 'cubic-bezier(0.55, 0.05, 0.68, 0.19)', fill: 'forwards' },
      );
    visibles.forEach(({ li }, i) => animar(li, i * PASO));
    resto.forEach((li) => animar(li, 0));
    // Se cambia de página cuando la última ya casi ha desaparecido.
    return Math.round((DURACION + Math.max(visibles.length - 1, 0) * PASO) * 0.9);
  }

  if (galeria) {
    llegar();
    // La cabecera la usa al pulsar una sección (coordina su latido con esto).
    (window as unknown as { __salida?: () => number }).__salida = salir;
    // Cualquier otro enlace que saque de la sección (firma, idioma, menú del
    // móvil…). Los de las propias tarjetas no: abrir una obra no es irse.
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented) return;
      const a = (e.target as Element).closest('a');
      if (!a || a.closest('.galeria')) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target === '_blank') return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin || (url.pathname === location.pathname && url.hash)) return;
      const ms = salir();
      if (!ms) return;
      e.preventDefault();
      setTimeout(() => (location.href = a.href), ms);
    });
    // Al volver con el botón "atrás", el navegador puede enseñar la página tal
    // como quedó (con las tarjetas fuera): se las hace llegar de nuevo.
    addEventListener('pageshow', (e) => e.persisted && llegar());
  }

  // ---------- Color en pantallas táctiles ----------
  const COMO_MUCHO = 2;
  if (galeria && !matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let pendiente = false;
    const colorear = () => {
      pendiente = false;
      const centro = innerHeight / 2;
      const candidatas = [];
      for (const t of galeria.querySelectorAll<HTMLElement>('li:not([hidden]) .tarjeta')) {
        const r = t.getBoundingClientRect();
        if (!r.height) continue; // escondida por el filtro "Disponibles"
        // Cuánto de la tarjeta se ve: las que apenas asoman no cuentan.
        const visible = (Math.min(r.bottom, innerHeight) - Math.max(r.top, 0)) / r.height;
        if (visible < 0.4) continue;
        candidatas.push({ t, distancia: Math.abs((r.top + r.bottom) / 2 - centro) + r.left / 1000 });
      }
      const elegidas = new Set(candidatas.sort((a, b) => a.distancia - b.distancia).slice(0, COMO_MUCHO).map((c) => c.t));
      for (const t of galeria.querySelectorAll('.tarjeta')) t.classList.toggle('en-color', elegidas.has(t));
    };
    const pedir = () => {
      if (!pendiente) (pendiente = true), requestAnimationFrame(colorear);
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    for (const b of botones) b.addEventListener('click', pedir);
    pedir();
  }
</script>

<style>
  .filtro {
    display: flex;
    gap: 1rem;
    margin: -0.5rem 0 1.5rem;
  }

  .filtro button {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: var(--suave);
    cursor: pointer;
  }

  .filtro button[aria-pressed='true'] {
    color: var(--texto);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Dos columnas en el móvil y la tableta, cuatro en ordenador (corte en
     1000 px, como en la web de Blanca). La separación es algo menor que la
     de Blanca para que las tarjetas ganen tamaño (pedido de Guzmán). */
  .galeria {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem clamp(0.4rem, 0.7vw, 0.75rem);
  }

  @media (min-width: 1000px) {
    .galeria {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem clamp(0.4rem, 0.7vw, 0.75rem);
    }
  }

  .galeria.por-llegar li {
    visibility: hidden;
  }

  .galeria[data-mostrando='disponibles'] li[data-vendida] {
    display: none;
  }

  /* La tarjeta: un bloque blanco con relieve (sombra).
     Ocupa todo el alto de la fila para que las de una fila midan lo mismo. */
  .tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    background: var(--fondo);
    border-radius: 3px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 4px 12px rgb(0 0 0 / 0.06);
    transition:
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .foto {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--vacio);
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.6s ease;
  }

  /* Con ratón: al pasar por encima, la foto toma color y la tarjeta se
     levanta un poco (más sombra y unos píxeles hacia arriba). */
  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover,
    .tarjeta:focus-visible {
      transform: translateY(-4px);
      box-shadow:
        0 4px 8px rgb(0 0 0 / 0.08),
        0 18px 36px rgb(0 0 0 / 0.14);
    }
    .tarjeta:hover img,
    .tarjeta:focus-visible img {
      filter: grayscale(0);
    }
  }

  /* Pantallas táctiles: el color llega con el scroll (ver el script). */
  .tarjeta.en-color img {
    filter: grayscale(0);
    transition-duration: 0.9s;
  }

  .pie-tarjeta {
    padding: 0.75rem 0.9rem 0.9rem;
  }

  p {
    margin: 0;
  }

  /* El título de la obra va en la serif, como el resto de títulos. */
  .titulo {
    font-family: var(--serif);
    font-size: calc(1em * var(--serif-escala));
    font-weight: 400;
  }

  .titulo span,
  .datos {
    color: var(--suave);
  }

  .datos,
  .pie-tarjeta :global(.estado-tarjeta) {
    font-size: 0.9em;
  }

  /* En dos columnas de móvil la tarjeta es estrecha: letra y relleno menores. */
  @media (max-width: 699px) {
    .pie-tarjeta {
      padding: 0.55rem 0.6rem 0.65rem;
    }
    .titulo {
      font-size: calc(0.9em * var(--serif-escala));
    }
    .datos,
    .pie-tarjeta :global(.estado-tarjeta) {
      font-size: 0.8em;
    }
  }

  /* Quien pide en su sistema menos movimiento: sin levantar la tarjeta. */
  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .foto img {
      transition: none;
    }
    .tarjeta:hover {
      transform: none;
    }
  }
</style>
