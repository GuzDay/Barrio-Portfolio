---
// Carrusel en 3D (página de Contacto, pedido de Guzmán, 21-10-2026): las
// fotos, en tarjetas verticales 3:4, forman un anillo que gira solo y sin
// pausa, visto un poco desde arriba. Solo CSS: el anillo es una caja en 3D
// (preserve-3d) y cada foto va girada su parte de la vuelta y empujada hacia
// fuera; las que dan la espalda no se ven.
import { Image } from 'astro:assets';
import { marco34 } from '../lib/fotos';

interface Props {
  fotos: ImageMetadata[];
}

const { fotos } = Astro.props;
// Con pocas fotos el anillo es pequeño y solo se ven dos a la vez: se repiten
// hasta tener al menos 10, para que se vea la curva del carrusel.
const caras = Array.from({ length: Math.ceil(10 / fotos.length) }, () => fotos).flat();
const n = caras.length;
// Distancia del centro a cada foto, en anchos de foto: la justa para que,
// con n fotos, entre una y la siguiente quede un pequeño hueco (un 8 %).
const radio = (0.5 / Math.tan(Math.PI / n)) * 1.08;
---

<div class="escena" aria-hidden="true" style={`--n: ${n}; --radio: ${radio.toFixed(3)}`}>
  <div class="anillo">
    {caras.map((foto, i) => (
      <div class="cara" style={`--i: ${i}`}>
        <Image
          src={foto}
          alt=""
          {...marco34(foto, [240, 360, 480, 720])}
          sizes="(min-width: 1500px) 210px, (max-width: 929px) 130px, 14vw"
          loading="eager"
          draggable="false"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .escena {
    /* Ancho de cada foto: crece con la pantalla, entre 130 y 210 px. En el
       móvil el anillo es más ancho que la pantalla y sus lados se salen por
       los bordes, como si siguiera. */
    --ancho: clamp(130px, 14vw, 210px);
    display: flex;
    justify-content: center;
    /* La foto que pasa por delante se ve más grande (está más cerca):
       sitio arriba y abajo para que no se monte sobre el texto. */
    padding: calc(var(--ancho) * 0.3) 0 calc(var(--ancho) * 0.7);
    perspective: calc(var(--ancho) * 10);
    perspective-origin: 50% 35%;
    /* Ocupa todo el ancho de la pantalla (sin los márgenes de la página) y
       recorta lo que se sale por los lados: si no, en el móvil el anillo
       ensanchaba la página entera. */
    margin-inline: calc(-1 * var(--lateral));
    overflow-x: clip;
  }

  .anillo {
    position: relative;
    width: var(--ancho);
    aspect-ratio: 3 / 4;
    transform-style: preserve-3d;
    /* Una vuelta cada 60 s, siempre a la misma velocidad: sin pausas. */
    animation: girar 60s linear infinite;
  }

  .cara {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(calc(var(--ancho) * var(--radio)));
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cara :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--vacio);
    user-select: none;
  }

  @keyframes girar {
    from {
      transform: rotateX(-6deg) rotateY(0deg);
    }
    to {
      transform: rotateX(-6deg) rotateY(-360deg);
    }
  }

  /* Quien pide menos movimiento ve el anillo quieto. */
  @media (prefers-reduced-motion: reduce) {
    .anillo {
      animation: none;
      transform: rotateX(-6deg);
    }
  }
</style>
