---
// Cabecera: nombre, menú e idioma. En el móvil el menú se pliega tras un botón;
// el cambio de idioma se queda siempre a la vista.
import {
  secciones,
  urlAcercaDe,
  urlContacto,
  urlEncargos,
  urlInicio,
  urlSeccion,
  type Idioma,
} from '../lib/rutas';
import { sitio } from '../lib/sitio';
import firma from '../assets/firma.svg?raw';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  alternativas: Record<Idioma, string>;
  activa?: string;
  blanca?: boolean; // en la portada va sobre la foto: firma y menú en blanco
}

const { idioma, alternativas, activa, blanca } = Astro.props;
// La firma va metida en la página (no como <img>) para que tome el color del
// texto: negra normalmente y blanca en la portada. Safari no aplica filtros de
// color a una imagen SVG, así que no vale con pintarla de blanco por CSS.
const firmaEnLinea = firma.replace('<svg ', '<svg fill="currentColor" ');
const t = textos[idioma];
const menu = [
  { clave: 'cuadros', texto: secciones.cuadros.nombre[idioma], url: urlSeccion('cuadros', idioma) },
  { clave: 'esculturas', texto: secciones.esculturas.nombre[idioma], url: urlSeccion('esculturas', idioma) },
  { clave: 'encargos', texto: t.encargos, url: urlEncargos(idioma) },
  { clave: 'acerca', texto: t.acercaDe, url: urlAcercaDe(idioma) },
  { clave: 'contacto', texto: t.contacto, url: urlContacto(idioma) },
];
---

<header class:list={['cabecera', { blanca }]}>
  <a class="marca" href={urlInicio(idioma)} set:html={firmaEnLinea} />
  <button class="abrir" type="button" aria-expanded="false" aria-controls="menu">{t.menu}</button>
  <nav id="menu" class="menu">
    <ul>
      {menu.map(({ clave, texto, url }) => (
        <li><a href={url} aria-current={activa === clave ? 'page' : undefined}>{texto}</a></li>
      ))}
    </ul>
  </nav>
  <div class="idiomas" aria-label={t.idioma}>
    <a href={alternativas.es} lang="es" hreflang="es" data-idioma="es" aria-current={idioma === 'es' ? 'true' : undefined}>ES</a>
    <a href={alternativas.en} lang="en" hreflang="en" data-idioma="en" aria-current={idioma === 'en' ? 'true' : undefined}>EN</a>
  </div>
</header>

<script>
  // Elegir idioma a mano manda sobre el del navegador, y se recuerda.
  for (const enlace of document.querySelectorAll<HTMLAnchorElement>('.idiomas a[data-idioma]')) {
    enlace.addEventListener('click', () => {
      try {
        localStorage.setItem('idioma', enlace.dataset.idioma!);
      } catch {
        /* ventana privada: se cambia igual, solo que no se recuerda */
      }
    });
  }

  // Botón del menú en el móvil.
  const boton = document.querySelector<HTMLButtonElement>('.cabecera .abrir')!;
  boton.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
  });
  // Al pulsar "Contacto" el menú lleva a otra parte de la misma página: se cierra.
  for (const enlace of document.querySelectorAll('.cabecera .menu a')) {
    enlace.addEventListener('click', () => boton.setAttribute('aria-expanded', 'false'));
  }
</script>

<style>
  .cabecera {
    padding: 1.1rem var(--lateral);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  /* La firma de Pablo: src/assets/firma.svg, sacada tal cual de scripts/firma/Firma Barrio.svg
     (el archivo que pasó Guzmán) sin los datos internos de Adobe y con el recuadro
     ajustado al borde de la tinta. Toma el color del texto. */
  .marca {
    margin-right: auto;
    color: var(--texto);
  }

  .marca :global(svg) {
    display: block;
    aspect-ratio: 1840.62 / 687.38;
    height: 56px;
    width: auto;
  }

  @media (max-width: 899px) {
    .marca :global(svg) {
      height: 44px;
    }
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }

  .menu a,
  .idiomas a {
    text-decoration: none;
    color: var(--suave);
  }

  .menu a:hover,
  .idiomas a:hover,
  .menu a[aria-current],
  .idiomas a[aria-current] {
    color: var(--texto);
  }

  .menu a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .idiomas {
    display: flex;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  /* Cabecera blanca (portada, sobre la foto). */
  .blanca .marca {
    color: #fff;
  }

  .blanca .menu a,
  .blanca .idiomas a {
    color: rgb(255 255 255 / 0.75);
  }

  .blanca .menu a:hover,
  .blanca .idiomas a:hover,
  .blanca .menu a[aria-current],
  .blanca .idiomas a[aria-current],
  .blanca .abrir {
    color: #fff;
  }

  .abrir {
    display: none;
    font: inherit;
    background: none;
    border: 0;
    padding: 0.25rem 0;
    color: var(--texto);
    cursor: pointer;
  }

  /* Móvil: nombre, idioma y botón de menú en una línea; el menú se despliega
     debajo, a todo el ancho. */
  @media (max-width: 899px) {
    .cabecera {
      padding-block: 0.9rem;
    }
    .abrir {
      display: block;
      order: 3;
    }
    .idiomas {
      order: 2;
    }
    .menu {
      order: 4;
      flex-basis: 100%;
      display: none;
    }
    .abrir[aria-expanded='true'] ~ .menu {
      display: block;
    }
    .menu ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0 0.75rem;
    }
    .menu a {
      display: block;
      padding: 0.6rem 0;
      font-size: 1.1rem;
    }
  }
</style>
