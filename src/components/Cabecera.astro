---
// Cabecera: nombre, menú e idioma. En el móvil el menú se pliega tras un botón;
// el cambio de idioma se queda siempre a la vista.
import {
  secciones,
  urlContacto,
  urlEncargos,
  urlInicio,
  urlSeccion,
  type Idioma,
} from '../lib/rutas';
import { sitio } from '../lib/sitio';
import firma from '../assets/firma.svg?raw';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  alternativas: Record<Idioma, string>;
  activa?: string;
  blanca?: boolean; // en la portada va sobre la foto: firma y menú en blanco
}

const { idioma, alternativas, activa, blanca } = Astro.props;
// La firma va metida en la página (no como <img>) para que tome el color del
// texto: negra normalmente y blanca en la portada. Safari no aplica filtros de
// color a una imagen SVG, así que no vale con pintarla de blanco por CSS.
const firmaEnLinea = firma.replace('<svg ', '<svg fill="currentColor" ');
const t = textos[idioma];
const menu = [
  { clave: 'cuadros', texto: secciones.cuadros.nombre[idioma], url: urlSeccion('cuadros', idioma) },
  { clave: 'esculturas', texto: secciones.esculturas.nombre[idioma], url: urlSeccion('esculturas', idioma) },
  { clave: 'encargos', texto: t.encargos, url: urlEncargos(idioma) },
  { clave: 'contacto', texto: t.contacto, url: urlContacto(idioma) },
];
---

<header class:list={['cabecera', { blanca }]}>
  <a class="marca" href={urlInicio(idioma)} set:html={firmaEnLinea} />
  <button class="abrir" type="button" aria-expanded="false" aria-controls="menu" aria-label={t.menu} data-abrir={t.menu} data-cerrar={t.cerrar}>
    <span class="icono" aria-hidden="true"></span>
  </button>
  <nav id="menu" class="menu">
    <ul>
      {menu.map(({ clave, texto, url }) => (
        <li><a href={url} aria-current={activa === clave ? 'page' : undefined}>{texto}</a></li>
      ))}
    </ul>
  </nav>
  <div class="idiomas" aria-label={t.idioma}>
    <a href={alternativas.es} lang="es" hreflang="es" data-idioma="es" aria-current={idioma === 'es' ? 'true' : undefined}>ES</a>
    <a href={alternativas.en} lang="en" hreflang="en" data-idioma="en" aria-current={idioma === 'en' ? 'true' : undefined}>EN</a>
  </div>
</header>

<script>
  // Elegir idioma a mano manda sobre el del navegador, y se recuerda.
  for (const enlace of document.querySelectorAll<HTMLAnchorElement>('.idiomas a[data-idioma]')) {
    enlace.addEventListener('click', () => {
      try {
        localStorage.setItem('idioma', enlace.dataset.idioma!);
      } catch {
        /* ventana privada: se cambia igual, solo que no se recuerda */
      }
    });
  }

  // Botón del menú en el móvil.
  const boton = document.querySelector<HTMLButtonElement>('.cabecera .abrir')!;
  const abrir = (si: boolean) => {
    boton.setAttribute('aria-expanded', String(si));
    boton.setAttribute('aria-label', (si ? boton.dataset.cerrar : boton.dataset.abrir)!);
  };
  boton.addEventListener('click', () => abrir(boton.getAttribute('aria-expanded') !== 'true'));
  // Al pulsar una entrada del menú en el móvil, el menú se cierra.
  for (const enlace of document.querySelectorAll('.cabecera .menu a')) {
    enlace.addEventListener('click', () => abrir(false));
  }
</script>

<style>
  /* La letra de la cabecera va 2 px por debajo de la del resto de la web
     (13 px con la base de 15): pedido de Guzmán. Lo de dentro va en em. */
  .cabecera {
    font-size: calc((1em - 2px) * var(--serif-escala));
    padding: 1.1rem var(--lateral);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  /* La firma de Pablo: src/assets/firma.svg, sacada tal cual de scripts/firma/Firma Barrio.svg
     (el archivo que pasó Guzmán) sin los datos internos de Adobe y con el recuadro
     ajustado al borde de la tinta. Toma el color del texto. */
  .marca {
    margin-right: auto;
    color: var(--texto);
  }

  .marca :global(svg) {
    display: block;
    aspect-ratio: 1840.62 / 687.38;
    height: 56px;
    width: auto;
  }

  @media (max-width: 899px) {
    .marca :global(svg) {
      height: 44px;
    }
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }

  .menu a,
  .idiomas a {
    text-decoration: none;
    color: var(--suave);
  }

  .menu a:hover,
  .idiomas a:hover,
  .menu a[aria-current],
  .idiomas a[aria-current] {
    color: var(--texto);
  }

  .idiomas {
    display: flex;
    gap: 0.6rem;
  }

  /* Ordenador, como en offforum.com: al pasar el ratón, una raya fina crece
     bajo la palabra de izquierda a derecha (0,5 s, arranca y frena suave) y
     al quitarlo se recoge hacia la izquierda. La sección en la que se está
     la tiene siempre puesta. */
  @media (min-width: 900px) {
    /* Todos como bloque: así las secciones y el idioma tienen la misma caja
       y la raya queda a la misma altura (antes la de "EN" iba 2,5 px más
       baja). */
    .menu a,
    .idiomas a {
      position: relative;
      display: block;
    }
    .menu a::after,
    .idiomas a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -3px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s cubic-bezier(0.76, 0, 0.24, 1);
    }
    .menu a:hover::after,
    .menu a:focus-visible::after,
    .menu a[aria-current]::after,
    .idiomas a:hover::after,
    .idiomas a:focus-visible::after {
      transform: scaleX(1);
    }
  }

  /* En todas las pantallas, el selector enseña solo el OTRO idioma. */
  .idiomas a[aria-current] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu a::after,
    .idiomas a::after {
      transition: none;
    }
  }

  /* Cabecera blanca (portada, sobre la foto). */
  .blanca .marca {
    color: #fff;
  }

  .blanca .menu a,
  .blanca .idiomas a {
    color: rgb(255 255 255 / 0.75);
  }

  .blanca .menu a:hover,
  .blanca .idiomas a:hover,
  .blanca .menu a[aria-current],
  .blanca .idiomas a[aria-current],
  .blanca .abrir {
    color: #fff;
  }

  /* Botón del menú en el móvil: tres rayas finas que, abierto, se vuelven
     una equis. Medidas copiadas de la web de Blanca (20 px de ancho, rayas
     de 1 px separadas 6 px). El botón es más grande que el dibujo para que
     sea fácil de tocar; el margen negativo lo deja alineado con el borde. */
  .abrir {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: -0.9rem calc(var(--margen) * -0.4) -0.9rem 0;
    padding: 0;
    background: none;
    border: 0;
    color: var(--texto);
    cursor: pointer;
  }

  .icono,
  .icono::before,
  .icono::after {
    width: 20px;
    height: 1px;
    background: currentColor;
  }

  .icono {
    position: relative;
    transition: background-color 0.2s ease;
  }

  .icono::before,
  .icono::after {
    content: '';
    position: absolute;
    left: 0;
    transition: transform 0.25s ease;
  }

  .icono::before {
    top: -6px;
  }

  .icono::after {
    top: 6px;
  }

  .abrir[aria-expanded='true'] .icono {
    background-color: transparent;
  }

  .abrir[aria-expanded='true'] .icono::before {
    transform: translateY(6px) rotate(45deg);
  }

  .abrir[aria-expanded='true'] .icono::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Móvil: firma, idioma y botón de menú en una línea; el menú se despliega
     debajo, a todo el ancho. */
  @media (max-width: 899px) {
    .cabecera {
      padding-block: 0.9rem;
      gap: 0.5rem 0.6rem;
    }
    .abrir {
      display: flex;
      order: 3;
    }
    /* El idioma, pequeño y algo espaciado, como en la web de Blanca. */
    .idiomas {
      order: 2;
      gap: 0.3rem;
      margin-right: 0.35rem;
      font-size: 0.846em; /* 11 px */
    }
    .idiomas a {
      padding: 0.4rem 0.15rem; /* zona de toque, sin agrandar el texto */
      letter-spacing: 0.04em;
      color: var(--texto);
    }
    .blanca .idiomas a {
      color: #fff;
    }
    .menu {
      order: 4;
      flex-basis: 100%;
      display: none;
    }
    .abrir[aria-expanded='true'] ~ .menu {
      display: block;
    }
    .menu ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0 0.75rem;
    }
    .menu a {
      display: block;
      padding: 0.6rem 0;
      font-size: 1.115em; /* 14,5 px */
    }
    .menu a[aria-current] {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }
</style>
