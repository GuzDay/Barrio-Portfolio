---
// Cabecera, inspirada en gionatannese.com (pedido de Guzmán, 16-10-2026):
//  - Todo fijo arriba: no se va al hacer scroll.
//  - La firma, en blanco con fusión "exclusión": sobre fondo claro se ve casi
//    negra y sobre las fotos cambia de color, así siempre se lee.
//  - El menú, en cajitas de cristal translúcido (gris claro al 50 % y lo de
//    detrás desenfocado), cada una con su nombre. Al pasar el ratón, la cajita
//    se ensancha un poco con una curva suave; la sección actual va algo más
//    oscura.
//  - El idioma (solo el otro: "EN" en la web en castellano) y, en el móvil, el
//    botón del menú, en cajitas iguales.
//
// El elemento <header> solo reserva el alto; cada pieza va fija por su
// cuenta. La firma tiene que ir suelta: si estuviera dentro de una capa
// propia, la fusión se haría con esa capa y no con la página.
import {
  secciones,
  urlContacto,
  urlEncargos,
  urlInicio,
  urlSeccion,
  type Idioma,
} from '../lib/rutas';
import firma from '../assets/firma.svg?raw';
import { textos } from '../lib/textos';

interface Props {
  idioma: Idioma;
  alternativas: Record<Idioma, string>;
  activa?: string;
  blanca?: boolean; // portada: la firma va blanca del todo, sobre la foto
}

const { idioma, alternativas, activa, blanca } = Astro.props;
const firmaEnLinea = firma.replace('<svg ', '<svg fill="currentColor" ');
const t = textos[idioma];
const menu = [
  { clave: 'cuadros', texto: secciones.cuadros.nombre[idioma], url: urlSeccion('cuadros', idioma) },
  { clave: 'esculturas', texto: secciones.esculturas.nombre[idioma], url: urlSeccion('esculturas', idioma) },
  { clave: 'encargos', texto: t.encargos, url: urlEncargos(idioma) },
  { clave: 'contacto', texto: t.contacto, url: urlContacto(idioma) },
];
---

<header class:list={['cabecera', { blanca }]}>
  <a class="marca" href={urlInicio(idioma)} set:html={firmaEnLinea} />

  <nav id="menu" class="menu" aria-label={t.menu}>
    <ul>
      {menu.map(({ clave, texto, url }) => (
        <li><a class="caja" href={url} aria-current={activa === clave ? 'page' : undefined}>{texto}</a></li>
      ))}
    </ul>
    <button class="cerrar caja" type="button" aria-label={t.cerrar}><span aria-hidden="true">×</span></button>
  </nav>
  <script is:inline>
    // Continuidad al cambiar de sección (ordenador). Al pulsar una cajita del
    // menú, la página anterior apunta cuál era y cuánto se había ensanchado.
    // Aquí, antes de pintar la página nueva, esa cajita aparece con ese mismo
    // ancho y sigue su animación desde ahí, en vez de empezar encogida y
    // volver a crecer (el navegador no sabe que el ratón sigue encima hasta
    // que se mueve). Ver también el script de abajo.
    (function () {
      var dato;
      try {
        dato = JSON.parse(sessionStorage.getItem('caja-sigue') || 'null');
        sessionStorage.removeItem('caja-sigue');
      } catch (e) {
        return;
      }
      if (!dato || Date.now() - dato.t > 4000) return;
      if (!matchMedia('(min-width: 900px) and (hover: hover)').matches) return;
      var caja = document.querySelectorAll('.cabecera .menu a.caja')[dato.i];
      if (!caja) return;
      caja.style.transition = 'none';
      caja.style.paddingLeft = caja.style.paddingRight = dato.px + 'px';
      caja.classList.add('sigue');
      // El tramo que falta se hace con una curva que sale ya con velocidad y
      // frena suave: así parece la misma animación, sin pausa al retomarla.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          caja.style.transition = 'padding 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease';
          caja.style.paddingLeft = caja.style.paddingRight = '';
          setTimeout(function () {
            caja.style.transition = '';
          }, 400);
        });
      });
    })();
  </script>

  <div class="idiomas caja" aria-label={t.idioma}>
    <a href={alternativas.es} lang="es" hreflang="es" data-idioma="es" aria-current={idioma === 'es' ? 'true' : undefined}>ES</a>
    <a href={alternativas.en} lang="en" hreflang="en" data-idioma="en" aria-current={idioma === 'en' ? 'true' : undefined}>EN</a>
  </div>

  <button class="abrir caja" type="button" aria-expanded="false" aria-controls="menu" aria-label={t.menu} data-abrir={t.menu} data-cerrar={t.cerrar}>
    <span class="icono" aria-hidden="true"></span>
  </button>
</header>

<script>
  // Elegir idioma a mano manda sobre el del navegador, y se recuerda.
  for (const enlace of document.querySelectorAll<HTMLAnchorElement>('.idiomas a[data-idioma]')) {
    enlace.addEventListener('click', () => {
      try {
        localStorage.setItem('idioma', enlace.dataset.idioma!);
      } catch {
        /* ventana privada: se cambia igual, solo que no se recuerda */
      }
    });
  }

  // Botón del menú en el móvil.
  const boton = document.querySelector<HTMLButtonElement>('.cabecera .abrir')!;
  const panel = document.querySelector('.cabecera .menu')!;
  const abrir = (si: boolean) => {
    panel.classList.toggle('abierto', si);
    document.documentElement.classList.toggle('menu-abierto', si);
    boton.setAttribute('aria-expanded', String(si));
    boton.setAttribute('aria-label', (si ? boton.dataset.cerrar : boton.dataset.abrir)!);
  };
  boton.addEventListener('click', () => abrir(boton.getAttribute('aria-expanded') !== 'true'));
  // Se cierra con la "×" de abajo, tocando fuera de las cajitas o con Esc.
  panel.querySelector('.cerrar')!.addEventListener('click', () => abrir(false));
  panel.addEventListener('click', (e) => e.target === panel && abrir(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && abrir(false));
  // Al pulsar una sección (ordenador): un pequeño latido. La cajita crece de
  // golpe un poco más (hasta 28 px por lado, arrancando rápido como el paso
  // del ratón) y vuelve con suavidad a su tamaño. Para
  // que se vea, el cambio de página espera 180 ms, justo pasado el pico; el
  // regreso termina ya en la página nueva gracias a la continuidad (ver el
  // script de justo debajo del menú), que apunta cuánto medía la cajita al
  // irse. Con Cmd/Ctrl/Mayús o botón central (abrir en otra pestaña) no se
  // toca nada.
  const cajas = [...document.querySelectorAll<HTMLAnchorElement>('.cabecera .menu a.caja')];
  const apuntar = (caja: HTMLAnchorElement, i: number) => {
    try {
      const px = parseFloat(getComputedStyle(caja).paddingLeft);
      sessionStorage.setItem('caja-sigue', JSON.stringify({ i, px, t: Date.now() }));
    } catch {
      /* sin almacenamiento, simplemente no hay continuidad */
    }
  };
  const conRaton = matchMedia('(min-width: 900px) and (hover: hover)');
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)');
  cajas.forEach((caja, i) =>
    caja.addEventListener('click', (e) => {
      const normal = e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
      if (!normal || sinMovimiento.matches) return apuntar(caja, i);
      if (!conRaton.matches) return latidoMovil(e, caja);
      e.preventDefault();
      const ahora = getComputedStyle(caja).paddingLeft;
      caja.animate(
        [
          { paddingLeft: ahora, paddingRight: ahora, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          { paddingLeft: '28px', paddingRight: '28px', offset: 0.3, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' },
          { paddingLeft: '16px', paddingRight: '16px' },
        ],
        { duration: 450 },
      );
      // Si la página tiene animación de salida (las tarjetas de Pintura y
      // Escultura), se lanza a la vez y se espera a que termine.
      const salida = (window as unknown as { __salida?: () => number }).__salida?.() ?? 0;
      setTimeout(() => {
        apuntar(caja, i);
        location.href = caja.href;
      }, Math.max(180, salida));
    }),
  );
  // En el menú del móvil las cajitas miden todas lo mismo, así que el latido
  // es un agrandarse un 8 % y volver, con la misma curva; luego se cambia de
  // página (esperando también a la salida de las tarjetas, si la hay).
  function latidoMovil(e: MouseEvent, caja: HTMLAnchorElement) {
    e.preventDefault();
    caja.animate(
      [
        { transform: 'scale(1)', easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        { transform: 'scale(1.08)', offset: 0.3, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' },
        { transform: 'scale(1)' },
      ],
      { duration: 450 },
    );
    const salida = (window as unknown as { __salida?: () => number }).__salida?.() ?? 0;
    setTimeout(() => (location.href = caja.href), Math.max(180, salida));
  }

  // La cajita que viene "ensanchada" de la página anterior se encoge (con su
  // animación de siempre) en cuanto el ratón se mueve fuera de ella.
  const quitarSigue = (e: PointerEvent) => {
    const sigue = document.querySelector('.cabecera .caja.sigue');
    if (!sigue) return removeEventListener('pointermove', quitarSigue);
    if (!sigue.contains(e.target as Node)) {
      sigue.classList.remove('sigue');
      removeEventListener('pointermove', quitarSigue);
    }
  };
  addEventListener('pointermove', quitarSigue, { passive: true });

  // Al pulsar una sección, el menú del móvil se cierra… salvo si está dando
  // su latido (entonces se queda abierto hasta que cambia la página, para
  // que el latido se vea).
  for (const enlace of document.querySelectorAll('.cabecera .menu a')) {
    enlace.addEventListener('click', (e) => !e.defaultPrevented && abrir(false));
  }
  // Al volver con "atrás", el navegador puede enseñar la página tal como
  // quedó, con el menú abierto: se cierra.
  addEventListener('pageshow', (e) => e.persisted && abrir(false));
</script>

<style>
  /* Reserva el alto de la cabecera, que ahora va fija (sus piezas no ocupan
     sitio en la página). La letra va 2 px por debajo de la base y en la
     serif un tamaño más (ver global.css). */
  .cabecera {
    height: 91px;
    font-size: calc((1em - 2px) * var(--serif-escala));
  }

  /* ---------- Firma ---------- */

  /* La firma de Pablo: src/assets/firma.svg, sacada tal cual de scripts/firma/Firma Barrio.svg
     (el archivo que pasó Guzmán) sin los datos internos de Adobe y con el recuadro
     ajustado al borde de la tinta. Blanca con fusión "exclusión" (como el
     "GN .D" de gionatannese.com): casi negra sobre el fondo claro y de otro
     color sobre las fotos. */
  .marca {
    position: fixed;
    top: 22px;
    left: var(--lateral);
    z-index: 60;
    color: #fff;
    mix-blend-mode: exclusion;
  }

  .marca :global(svg) {
    display: block;
    aspect-ratio: 1840.62 / 687.38;
    height: 48px;
    width: auto;
  }

  /* En la portada, blanca del todo sobre la foto (sin fusión). */
  .blanca .marca {
    mix-blend-mode: normal;
  }

  /* En la portada, el texto de las cajitas también en blanco (secciones,
     idioma, botón del menú y panel del móvil). Solo ahí. */
  .blanca .caja,
  .blanca .menu {
    color: #fff;
  }

  /* ---------- Cajitas de cristal ---------- */

  /* El texto va bajado 1,4 px (7,4 arriba y 4,6 abajo en vez de 6 y 6):
     Newsreader reserva mucho hueco para las colas de letras como la "g" y,
     con el relleno igual, las letras quedaban altas. Centrado del todo sobre
     la tinta (2,4 px) se veía bajo, porque el ojo centra por las minúsculas:
     se deja 1 px por encima de ese centro (ajuste a ojo de Guzmán). */
  .caja {
    display: flex;
    align-items: center;
    padding: 7.4px 8px 4.6px;
    border-radius: 4px;
    background: rgb(237 237 237 / 0.5);
    -webkit-backdrop-filter: blur(40px);
    backdrop-filter: blur(40px);
    color: var(--texto);
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  .caja:hover,
  .caja:focus-visible {
    background: rgb(216 216 216 / 0.5);
  }

  /* ---------- Menú (ordenador) ---------- */

  .menu {
    position: fixed;
    top: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }

  /* Al pasar el ratón, la cajita se ensancha 4 px por cada lado: rápida al
     principio y frenando despacio al final, para que responda al instante
     aunque el cursor pase deprisa por las cuatro (pedido de Guzmán). */
  .menu .caja {
    font-family: var(--serif);
    font-weight: 300;
    line-height: 1.1;
    padding-inline: 12px;
    white-space: nowrap;
    transition:
      padding 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.25s ease;
  }

  .menu .caja:hover,
  .menu .caja:focus-visible,
  .menu .caja.sigue {
    padding-inline: 16px;
  }

  .menu .caja[aria-current] {
    background: rgb(216 216 216 / 0.5);
  }

  .cerrar {
    display: none;
  }

  /* ---------- Idioma ---------- */

  .idiomas {
    position: fixed;
    top: 32px;
    right: var(--lateral);
    z-index: 50;
    /* La misma letra que las secciones del menú (Newsreader fina, mismo
       tamaño), como pidió Guzmán. */
    font-family: var(--serif);
    font-weight: 300;
    line-height: 1.1;
  }

  .idiomas a {
    color: inherit;
    text-decoration: none;
  }

  /* El selector enseña solo el OTRO idioma. */
  .idiomas a[aria-current] {
    display: none;
  }

  /* ---------- Botón del menú (móvil) ---------- */

  /* Tres rayas finas que, abierto, se vuelven una equis (medidas de la web
     de Blanca: 20 px de ancho, rayas de 1 px separadas 6 px). */
  .abrir {
    display: none;
    position: fixed;
    top: 20px;
    right: var(--lateral);
    z-index: 50;
    width: 2.25rem;
    height: 2rem;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    cursor: pointer;
  }

  .icono,
  .icono::before,
  .icono::after {
    width: 20px;
    height: 1px;
    background: currentColor;
  }

  .icono {
    position: relative;
    transition: background-color 0.2s ease;
  }

  .icono::before,
  .icono::after {
    content: '';
    position: absolute;
    left: 0;
    transition: transform 0.25s ease;
  }

  .icono::before {
    top: -6px;
  }

  .icono::after {
    top: 6px;
  }

  .abrir[aria-expanded='true'] .icono {
    background-color: transparent;
  }

  .abrir[aria-expanded='true'] .icono::before {
    transform: translateY(6px) rotate(45deg);
  }

  .abrir[aria-expanded='true'] .icono::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---------- Móvil ---------- */

  /* Firma a la izquierda; idioma y botón del menú en cajitas a la derecha.
     El menú se abre como un panel de cristal debajo. */
  @media (max-width: 899px) {
    .cabecera {
      height: 73px;
    }
    .marca {
      top: 17px;
    }
    .marca :global(svg) {
      height: 38px;
    }
    .abrir {
      display: flex;
    }
    .idiomas {
      top: 20px;
      right: calc(var(--lateral) + 2.25rem + 6px);
      height: 2rem;
      align-items: center;
      /* Bajado 1,8 px para centrar las letras a la vista (ver .caja). */
      padding: 3.6px 10px 0;
    }
    /* Menú abierto: toda la pantalla desenfocada y, en el centro, las
       secciones apiladas, cada una en su cajita de cristal (como en
       ordenador, algo más grandes para el dedo), y debajo una cajita con
       la "×" para cerrar. Entran una tras otra. Va por debajo de la firma y
       de los botones de arriba, que siguen a mano. */
    .menu {
      inset: 0;
      left: 0;
      transform: none;
      z-index: 45;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    /* El desenfoque del fondo va en una capa aparte, detrás de las cajitas, y
       no en el propio menú: si lo llevara el menú, las cajitas de dentro solo
       "verían" el fondo transparente del menú y su propio desenfoque no se
       notaría. Así cada cajita vuelve a desenfocar lo ya desenfocado: doble
       desenfoque, y el texto se lee mejor (pedido de Guzmán). */
    .menu::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: rgb(255 255 255 / 0.2);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
    .blanca .menu::before {
      background: rgb(0 0 0 / 0.15);
    }
    .menu.abierto {
      display: flex;
    }
    /* Las cuatro cajitas con el mismo ancho (el de la más larga) y el texto
       centrado: una columna limpia. */
    .menu ul {
      flex-direction: column;
      align-items: stretch;
      width: max-content;
      gap: 10px;
    }
    .menu .caja {
      justify-content: center;
      font-size: 1.35em;
      padding: 10.4px 20px 7.6px;
    }
    .menu .caja:hover,
    .menu .caja:focus-visible {
      padding-inline: 20px;
    }
    .menu .cerrar {
      display: flex;
      justify-content: center;
      width: 2.75rem;
      height: 2.6rem;
      margin-top: 10px;
      padding: 0 0 3px;
      border: 0;
      cursor: pointer;
      font-family: var(--sans);
      font-size: 1.9em;
      font-weight: 200;
      line-height: 1;
    }
    /* La entrada se anima sobre la propia cajita, no sobre su <li>: un
       contenedor con opacidad animándose impide que la cajita desenfoque lo
       de detrás, y se veían claras hasta que acababa cada una y entonces "se
       oscurecían" de una en una. "backwards": al acabar se suelta. */
    .menu.abierto .caja {
      animation: entrar-caja 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }
    .menu.abierto li:nth-child(2) .caja {
      animation-delay: 0.04s;
    }
    .menu.abierto li:nth-child(3) .caja {
      animation-delay: 0.08s;
    }
    .menu.abierto li:nth-child(4) .caja {
      animation-delay: 0.12s;
    }
    .menu.abierto .cerrar {
      animation-delay: 0.18s;
    }
    /* Relieve muy sutil, como con una luz desde arriba a la izquierda: filo
       claro arriba e izquierda, filo de sombra abajo y derecha, y una sombra
       exterior suave. Las separa más del fondo (pedido de Guzmán). */
    .menu .caja {
      box-shadow:
        inset 1px 1px 0 rgb(255 255 255 / 0.45),
        inset -1px -1px 0 rgb(0 0 0 / 0.08),
        1px 2px 6px rgb(0 0 0 / 0.1);
    }
  }

  /* Solo movimiento, sin fundido: con opacidad, mientras la cajita es
     semitransparente se ve el fondo sin su desenfoque y "se oscurece" al
     terminar. Así está igual desde el primer instante. */
  @keyframes entrar-caja {
    from {
      transform: translateY(14px) scale(0.94);
    }
  }

  /* Con el menú abierto, la página de detrás no se desplaza. */
  :global(html.menu-abierto) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .caja,
    .menu .caja {
      transition: none;
    }
    .menu.abierto .caja {
      animation: none;
    }
  }
</style>
