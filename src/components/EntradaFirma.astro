---
// Entrada de la portada: la firma de Pablo se escribe sola sobre el fondo y
// después se abre la web. Solo la primera vez en cada visita (si se vuelve a
// la portada no se repite), y nunca para quien tiene pedido en su sistema
// que se reduzcan las animaciones. Un clic o una tecla la saltan.
//
// La firma y el orden de los trazos salen de scripts/firma/generar.py.
import firma from '../assets/firma-animada.svg?raw';

const duracion = Number(firma.match(/data-duracion="([\d.]+)"/)![1]);
---

<div class="entrada" hidden data-duracion={duracion}>
  <Fragment set:html={firma.replace(/<!--.*?-->\n?/, '')} />
</div>
<script is:inline>
  // Va justo después de la capa, antes de que se pinte nada: así se decide
  // sin parpadeos si se enseña o no.
  (function () {
    var capa = document.currentScript.previousElementSibling;
    try {
      if (sessionStorage.getItem('firma-vista')) return capa.remove();
      sessionStorage.setItem('firma-vista', '1');
    } catch (e) {
      return capa.remove(); // sin almacenamiento se repetiría siempre: mejor no enseñarla
    }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return capa.remove();
    capa.hidden = false;
    document.documentElement.classList.add('con-entrada');
  })();
</script>

<script>
  const capa = document.querySelector<HTMLElement>('.entrada');
  if (capa && !capa.hidden) {
    let cerrada = false;
    const cerrar = () => {
      if (cerrada) return;
      cerrada = true;
      capa.classList.add('fuera');
      document.documentElement.classList.remove('con-entrada');
      setTimeout(() => capa.remove(), 700);
    };
    // Tras escribirse, la firma se queda un momento a la vista y se abre la web.
    setTimeout(cerrar, (Number(capa.dataset.duracion) + 0.6) * 1000);
    for (const evento of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
      addEventListener(evento, cerrar, { once: true, passive: true });
    }
  }
</script>

<style is:global>
  html.con-entrada {
    overflow: hidden;
  }

  .entrada {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--fondo);
    color: var(--texto);
    transition: opacity 0.7s ease;
  }

  .entrada[hidden] {
    display: none;
  }

  .entrada.fuera {
    opacity: 0;
    pointer-events: none;
  }

  .entrada svg {
    width: min(78vw, 560px);
    height: auto;
  }

  /* Cada trazo de la máscara se "dibuja" de principio a fin con su propio
     retraso y duración (vienen en el SVG). Antes de empezar está oculto, para
     que no asome el punto redondo del inicio. */
  .firma-animada mask path {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    animation-name: firmar;
    animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    animation-fill-mode: both;
  }

  @keyframes firmar {
    0% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
