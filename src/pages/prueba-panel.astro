---
// Página de prueba del panel de edición: enseña las obras tal como las guarda
// el panel, en su orden y en los dos idiomas. No es el diseño; se borra
// cuando existan las páginas de verdad.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const porOrden = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const secciones = [
  { nombre: 'Cuadros', obras: (await getCollection('cuadros')).sort(porOrden) },
  { nombre: 'Esculturas', obras: (await getCollection('esculturas')).sort(porOrden) },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Prueba del panel</title>
    <style>
      body { margin: 2rem 1rem; background: #f3efe9; color: #1a1a1a; font-family: system-ui, sans-serif; }
      main { max-width: 60rem; margin: auto; }
      ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1.5rem; }
      img { width: 100%; height: auto; display: block; }
      p { margin: 0.25rem 0; font-size: 0.9rem; }
      .en { color: #6b6b6b; }
    </style>
  </head>
  <body>
    <main>
      <h1>Prueba del panel</h1>
      {secciones.map(({ nombre, obras }) => (
        <section>
          <h2>{nombre}</h2>
          <ol>
            {obras.map(({ data }) => (
              <li>
                <Image src={data.fotos[0]} alt={data.titulo} width={600} />
                <p><strong>{data.order}. {data.titulo}</strong> · {data.anio} · {data.estado}</p>
                <p>{[data.tecnica, data.medidas, data.precio && `${data.precio} €`].filter(Boolean).join(' · ')}</p>
                <p class="en">EN: {data.en.tecnica ?? data.tecnica}</p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </main>
  </body>
</html>
