---
// Cuadros y Esculturas comparten página; cambia el nombre en la dirección.
import Seccion from '../../vistas/Seccion.astro';
import { secciones, type Seccion as S } from '../../lib/rutas';

export function getStaticPaths() {
  return (Object.keys(secciones) as S[]).map((seccion) => ({
    params: { seccion: secciones[seccion].slug.es },
    props: { seccion },
  }));
}
---

<Seccion idioma="es" seccion={Astro.props.seccion} />
